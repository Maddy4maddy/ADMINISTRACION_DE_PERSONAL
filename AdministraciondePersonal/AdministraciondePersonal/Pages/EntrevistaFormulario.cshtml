@page
@model AdministraciondePersonal.Pages.EntrevistaFormularioModel

@{
    Layout = null;
    ViewData["Title"] = Model.ModoEdicion ? "Cambiar datos de entrevista" : "Agendar nueva entrevista";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Vizualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">Usuario</span>
                <div class="user-avatar" id="userAvatar">U</div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">@ViewData["Title"]</h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">@Model.Mensaje</div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <div class="card">
                    <div class="card-body">

                        <form method="post">

                            <input type="hidden" asp-for="Entrevista.IdEntrevista" />

                            <div class="mb-3">
                                <label class="form-label">
                                    Oferente
                                </label>

                                @if (Model.ModoEdicion)
                                {
                                    <input type="text"
                                           class="form-control"
                                           value="@Model.Entrevista.IdentificacionOferente - @Model.Entrevista.NombreOferente"
                                           readonly />

                                    <input type="hidden"
                                           asp-for="Entrevista.IdentificacionOferente" />
                                }
                                else
                                {
                                    <select asp-for="Entrevista.IdentificacionOferente"
                                            class="form-select">

                                        <option value="">
                                            Seleccione un oferente
                                        </option>

                                        @foreach (var oferente in Model.Oferentes)
                                        {
                                            <option value="@oferente.Identificacion">
                                                @oferente.Identificacion - @oferente.NombreCompleto
                                            </option>
                                        }

                                    </select>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Empleado que realizará la entrevista
                                </label>

                                <select asp-for="Entrevista.IdUsuarioEntrevistador"
                                        class="form-select">

                                    <option value="0">
                                        Seleccione un empleado
                                    </option>

                                    @foreach (var empleado in Model.Entrevistadores)
                                    {
                                        <option value="@empleado.IdUsuario">
                                            @empleado.NombreCompleto
                                        </option>
                                    }

                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Fecha de la entrevista
                                </label>

                                <input asp-for="Entrevista.FechaEntrevista"
                                       type="datetime-local"
                                       class="form-control" />
                            </div>

                            @if (Model.ModoEdicion)
                            {
                                <button type="submit"
                                        asp-page-handler="Actualizar"
                                        class="btn btn-warning">
                                    Actualizar
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        asp-page-handler="Guardar"
                                        class="btn btn-primary">
                                    Guardar
                                </button>
                            }

                            <a asp-page="/Entrevistas"
                               class="btn btn-secondary">
                                Volver
                            </a>

                        </form>

                    </div>
                </div>

            </div>

        </div>

    </div>

</body>
</html>
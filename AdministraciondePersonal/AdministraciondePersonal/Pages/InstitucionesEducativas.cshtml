@page
@model AdministraciondePersonal.Pages.InstitucionesEducativasModel

@{
    Layout = null;
    ViewData["Title"] = "Administración Instituciones Educativas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Administración Instituciones Educativas</title>

    <!-- AUTOREFRESH: Recarga la página cada 5 minutos para verificar sesión -->
    <meta http-equiv="refresh" content="300; url=/Login?expirada=true">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .acciones-institucion {
                display: flex;
                gap: 6px;
                align-items: center;
                white-space: nowrap;
            }

                .acciones-institucion form {
                    margin: 0;
                }

            .tabla-instituciones {
                font-size: 14px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Bitacora" class="nav-link">
                    <span>Visualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/InstitucionesEducativas" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">
                    @Model.NombreUsuario
                </span>

                <div class="user-avatar" id="userAvatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Administración Instituciones Educativas
                </h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">
                        @Model.Mensaje
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        @(Model.ModoEdicion ? "Actualizar institución educativa" : "Nueva institución educativa")
                    </div>

                    <div class="card-body">

                        <form method="post">

                            <input type="hidden" asp-for="ModoEdicion" />
                            <input type="hidden" asp-for="Institucion.IdInstitucion" />

                            <div class="row">

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">
                                        Código de la institución
                                    </label>

                                    <input asp-for="Institucion.IdInstitucion"
                                           class="form-control"
                                           readonly />
                                </div>

                                <div class="col-md-8 mb-3">
                                    <label class="form-label">
                                        Nombre
                                    </label>

                                    <input asp-for="Institucion.NombreInstitucion"
                                           maxlength="150"
                                           class="form-control" />
                                </div>

                            </div>

                            @if (Model.ModoEdicion)
                            {
                                <button type="submit"
                                        asp-page-handler="Actualizar"
                                        class="btn btn-warning">
                                    Actualizar
                                </button>

                                <a href="/InstitucionesEducativas"
                                   class="btn btn-secondary">
                                    Cancelar
                                </a>
                            }
                            else
                            {
                                <button type="submit"
                                        asp-page-handler="Guardar"
                                        class="btn btn-primary">
                                    Guardar
                                </button>
                            }

                        </form>

                    </div>
                </div>

                <h4>
                    Lista de instituciones educativas
                </h4>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped tabla-instituciones">

                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.ListaInstituciones)
                            {
                                <tr>
                                    <td>@item.IdInstitucion</td>

                                    <td>@item.NombreInstitucion</td>

                                    <td>
                                        <div class="acciones-institucion">

                                            <a asp-page="/InstitucionesEducativas"
                                               asp-route-idInstitucion="@item.IdInstitucion"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?');">

                                                <input type="hidden"
                                                       name="idInstitucion"
                                                       value="@item.IdInstitucion" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
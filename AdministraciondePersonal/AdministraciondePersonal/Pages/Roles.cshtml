@page
@model AdministraciondePersonal.Pages.RolesModel

@{
    Layout = null;
    ViewData["Title"] = "Registro de Roles";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Roles</title>



    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link rel="stylesheet" href="~/css/pantallas.css?v=2">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item"><a href="/Bienvenida" class="nav-link">Dashboard</a></li>
            <li class="nav-item"><a href="/Roles" class="nav-link">Administración Roles</a></li>
            <li class="nav-item"><a href="/Usuarios" class="nav-link">Administración Usuarios</a></li>
            <li class="nav-item"><a href="/Oferentes" class="nav-link">Registro Oferentes</a></li>
            <li class="nav-item"><a href="/Concursos" class="nav-link">Registro Concursos</a></li>
            <li class="nav-item"><a href="/PreparacionAcademica" class="nav-link">Registro Preparación Académica</a></li>
            <li class="nav-item"><a href="/ExperienciaLaboral" class="nav-link">Experiencia Laboral</a></li>
            <li class="nav-item"><a href="/Entrevistas" class="nav-link">Agendar Entrevista</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Contratar Empleado</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Requisitos de Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Áreas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Acciones de Personal</a></li>
            <li class="nav-item"><a href="/Bitacora" class="nav-link">Visualizar Bitácoras</a></li>
            <li class="nav-item"><a href="/Parametros" class="nav-link">Administración Parámetros</a></li>
            <li class="nav-item"><a href="/Compañia" class="nav-link">Administración Compañías</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Cargar Datos de Ubicación</a></li>
            <li class="nav-item"><a href="/Pantalla" class="nav-link">Administracion de Pantallas</a></li>
            <li class="nav-item"><a href="/InstitucionesEducativas" class="nav-link">Administración Instituciones Educativas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Módulos</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">Registro de Roles</h2>

                <div class="oferentes-container">

                    <div class="header-acciones">

                        <h2>Listado de Roles</h2>

                        <button type="button"
                                class="btn-nuevo"
                                onclick="abrirModal()">
                            + Nuevo Rol
                        </button>

                    </div>

                    <div class="table-responsive">

                        <table class="tabla-pantallas">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre Rol</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var rol in Model.ListaRoles)
                                {
                                    <tr>

                                        <td>@rol.IdRol</td>

                                        <td>@rol.NombreRol</td>

                                        <td>

                                            <button type="button"
                                                    class="btn-accion btn-editar"
                                                    onclick="editarRol(@rol.IdRol)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn-accion btn-eliminar"
                                                    onclick="abrirModalEliminar(@rol.IdRol)">
                                                Eliminar
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MODAL CREAR / EDITAR -->

    <div id="modalRol" class="modal">

        <div class="modal-content">

            <h3>Administración de Roles</h3>

            <form method="post">

                <input type="hidden" asp-for="IdRolEditar" />

                <label>Nombre Rol</label>

                <input type="text"
                       asp-for="NombreRol"
                       maxlength="100"
                       required />

                <label>Pantallas</label>

                <div class="pantallas-container">

                    @foreach (var p in Model.Pantallas)
                    {
                        <div>

                            <input type="checkbox"
                                   class="chkPantalla"
                                   name="PantallasSeleccionadas"
                                   value="@p.IdPantalla" />

                            <label>@p.NombrePantalla</label>

                        </div>
                    }

                </div>

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModal()">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- MODAL ELIMINAR -->

    <div id="modalEliminar" class="modal">

        <div class="modal-content mensaje-confirmacion">

            <h3>Confirmar eliminación</h3>

            <p>¿Realmente desea eliminar el rol seleccionado?</p>

            <form method="post"
                  asp-page-handler="Delete">

                <input type="hidden"
                       id="idEliminar"
                       name="idRol" />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Sí
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModalEliminar()">
                        No
                    </button>

                </div>

            </form>

        </div>

    </div>

    @{
        bool esError = TempData["EsError"]?.ToString() == "true";
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="modal" style="display:flex;">

            <div class="modal-content @(esError ? "mensaje-error" : "mensaje-exito")">

                <h3>
                    @(esError ? "Error" : "Operación Exitosa")
                </h3>

                <p>@TempData["Mensaje"]</p>

                <div class="modal-buttons">

                    <a href="/Roles" class="btn-guardar">
                        Aceptar
                    </a>

                </div>

            </div>

        </div>
    }


    <script>

            function abrirModal() {

                document.querySelector("[name='NombreRol']").value = "";
                document.querySelector("[name='IdRolEditar']").value = "0";

                document.querySelectorAll(".chkPantalla").forEach(c => {
                    c.checked = false;
                });

                document.getElementById("modalRol").style.display = "flex";
            }

            function cerrarModal() {

                document.getElementById("modalRol").style.display = "none";
            }

            function editarRol(id) {

                fetch(`/Roles?handler=Rol&id=${id}`)
                    .then(r => r.json())
                    .then(data => {

                        document.querySelector("[name='NombreRol']").value =
                            data.rol.nombreRol;

                        document.querySelector("[name='IdRolEditar']").value =
                            data.rol.idRol;

                        document.querySelectorAll(".chkPantalla").forEach(c => {
                            c.checked = false;
                        });

                        data.pantallas.forEach(p => {

                            const chk = document.querySelector(
                                `.chkPantalla[value='${p.idPantalla}']`
                            );

                            if (chk)
                                chk.checked = true;
                        });

                        document.getElementById("modalRol").style.display = "flex";
                    });
            }

            function abrirModalEliminar(id) {

                document.getElementById("idEliminar").value = id;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {

                document.getElementById("modalEliminar").style.display = "none";
            }

    </script>
    


</body>
</html>
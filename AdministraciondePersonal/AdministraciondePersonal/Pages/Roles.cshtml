@page
@model AdministraciondePersonal.Pages.RolesModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Roles</title>
    <link rel="stylesheet" href="~/css/plantillaGlobal.css" />
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <h3>Sistema</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="/Roles" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Bitacora" class="nav-link">
                    <span>Visualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/InstitucionesEducativas" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">

        <div class="page-container">

            <div class="crud-container">

                <h2 class="crud-title">Gestión de Roles</h2>

                <button type="button" class="btn-nuevo" onclick="abrirModal()">
                    Nuevo Rol
                </button>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="mensaje-alerta">
                        @TempData["Mensaje"]
                    </div>
                }

                <table class="table-roles">
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var rol in Model.ListaRoles)
                        {
                            <tr>
                                <td>@rol.NombreRol</td>
                                <td>
                                    <button type="button"
                                            class="btn-editar"
                                            onclick="editarRol(@rol.IdRol)">
                                        Editar
                                    </button>

                                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                                        <input type="hidden" name="idRol" value="@rol.IdRol" />
                                        <button type="submit" class="btn-eliminar">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <!-- MODAL -->
    <div class="modal" id="modalRol">

        <div class="modal-content">

            <form method="post">

                <input type="hidden" asp-for="IdRolEditar" />

                <label>Nombre Rol</label>
                <input type="text" asp-for="NombreRol" />

                <label>Pantallas</label>

                <label>Pantallas</label>

                <div class="pantallas-container">
                    @foreach (var p in Model.Pantallas)
                    {
                        <div>
                            <input type="checkbox"
                                   class="chkPantalla"
                                   name="PantallasSeleccionadas"
                                   value="@p.IdPantalla" />

                            <label>@p.NombrePantalla</label>
                        </div>
                    }
                </div>

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Guardar</button>
                    <button type="button" class="btn-cancelar" onclick="cerrarModal()">Cancelar</button>
                </div>

            </form>

        </div>

    </div>

    <script>
        function abrirModal() {
            limpiarFormulario();
            document.getElementById("modalRol").style.display = "flex";
        }

        function cerrarModal() {
            document.getElementById("modalRol").style.display = "none";
        }

        function limpiarFormulario() {
            document.querySelector("[name='NombreRol']").value = "";
            document.querySelector("[name='IdRolEditar']").value = "0";

            document.querySelectorAll(".chkPantalla").forEach(c => {
                c.checked = false;
            });
        }

        function editarRol(id) {

            fetch(`/Roles?handler=Rol&id=${id}`)
                .then(r => r.json())
                .then(data => {

                    document.querySelector("[name='NombreRol']").value = data.rol.nombreRol;
                    document.querySelector("[name='IdRolEditar']").value = data.rol.idRol;

                    // limpiar checks primero
                    document.querySelectorAll(".chkPantalla").forEach(c => {
                        c.checked = false;
                    });

                    // marcar solo los que vienen del backend
                    data.pantallas.forEach(p => {
                        const chk = document.querySelector(
                            `.chkPantalla[value='${p.idPantalla}']`
                        );

                        if (chk) chk.checked = true;
                    });

                    document.getElementById("modalRol").style.display = "flex";
                });
        }
    </script>

</body>
</html>
@page
@model AdministraciondePersonal.Pages.ExperienciaLaboralModel

@{
    Layout = null;
    ViewData["Title"] = "Registro Experiencia Laboral";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro Experiencia Laboral</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .experiencia-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px;
                }

            .btn-nuevo {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 15px;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
            }

                .btn-nuevo:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .tabla-experiencia {
                width: 100%;
                border-collapse: collapse;
                overflow: hidden;
                border-radius: 20px;
                font-size: 14px;
            }

                .tabla-experiencia thead {
                    background-color: #80B0AA;
                    color: white;
                }

                .tabla-experiencia th,
                .tabla-experiencia td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eeeeee;
                    vertical-align: middle;
                }

                .tabla-experiencia tbody tr:hover {
                    background-color: #F9EAC1;
                }

            .acciones-experiencia {
                display: flex;
                gap: 8px;
                align-items: center;
                justify-content: center;
                white-space: nowrap;
            }

            .btn-accion {
                background: none;
                border: none;
                font-size: 16px;
                cursor: pointer;
                margin: 0 3px;
                padding: 5px 8px;
                border-radius: 10px;
                transition: 0.3s;
                text-decoration: none;
                display: inline-block;
                white-space: nowrap;
            }

            .btn-editar {
                color: #273a77;
            }

                .btn-editar:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .btn-eliminar {
                color: #d9534f;
            }

                .btn-eliminar:hover {
                    background-color: #d9534f;
                    color: white;
                }

            .btn-volver {
                color: #315855;
            }

                .btn-volver:hover {
                    background-color: #315855;
                    color: white;
                }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: white;
                border-radius: 30px;
                padding: 30px;
                width: 90%;
                max-width: 750px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.2);
                max-height: 90vh;
                overflow-y: auto;
            }

                .modal-content h3 {
                    color: #273a77;
                    margin-bottom: 20px;
                    font-size: 24px;
                }

                .modal-content label {
                    display: block;
                    margin-bottom: 5px;
                    color: #273a77;
                    font-weight: bold;
                }

                .modal-content input {
                    width: 100%;
                    padding: 10px;
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    font-size: 14px;
                    margin-bottom: 15px;
                    outline: none;
                }

                    .modal-content input:focus {
                        border-color: #FDB3CA;
                    }

            .modal-buttons {
                display: flex;
                gap: 15px;
                justify-content: flex-end;
                margin-top: 20px;
            }

                .modal-buttons button,
                .modal-buttons a {
                    padding: 10px 20px;
                    border-radius: 15px;
                    border: none;
                    cursor: pointer;
                    font-weight: bold;
                    text-decoration: none;
                }

            .btn-guardar {
                background-color: #273a77;
                color: white;
            }

            .btn-cancelar {
                background-color: #ccc;
                color: #333;
            }

            .mensaje-exito h3 {
                color: #2ECC71;
            }

            .mensaje-error h3 {
                color: #E74C3C;
            }

            .mensaje-confirmacion h3 {
                color: #273a77;
            }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item"><a href="/Bienvenida" class="nav-link">Dashboard</a></li>
            <li class="nav-item"><a href="/Roles" class="nav-link">Administración Roles</a></li>
            <li class="nav-item"><a href="/Usuarios" class="nav-link">Administración Usuarios</a></li>
            <li class="nav-item"><a href="/Oferentes" class="nav-link">Registro Oferentes</a></li>
            <li class="nav-item"><a href="/Concursos" class="nav-link">Registro Concursos</a></li>
            <li class="nav-item"><a href="/PreparacionAcademica" class="nav-link">Registro Preparación Académica</a></li>
            <li class="nav-item"><a href="/ExperienciaLaboral" class="nav-link">Experiencia Laboral</a></li>
            <li class="nav-item"><a href="/Entrevistas" class="nav-link">Agendar Entrevista</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Contratar Empleado</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Requisitos de Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Áreas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Acciones de Personal</a></li>
            <li class="nav-item"><a href="/Bitacora" class="nav-link">Visualizar Bitácoras</a></li>
            <li class="nav-item"><a href="/Parametros" class="nav-link">Administración Parámetros</a></li>
            <li class="nav-item"><a href="/Compañia" class="nav-link">Administración Compañías</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Cargar Datos de Ubicación</a></li>
            <li class="nav-item"><a href="/Pantalla" class="nav-link">Administracion de Pantallas</a></li>
            <li class="nav-item"><a href="/InstitucionesEducativas" class="nav-link">Administración Instituciones Educativas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Módulos</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Registro Experiencia Laboral</h2>

                <div class="experiencia-container">
                    <div class="header-acciones">
                        <h2>Historial de Experiencia Laboral</h2>
                        <div>
                            <a href="/ExperienciaLaboral?nuevo=true&identificacionOferente=@Model.IdentificacionOferenteSeleccionado" class="btn-nuevo">
                                + Nueva Experiencia
                            </a>
                            <a href="/Oferentes" class="btn-accion btn-volver">
                                Volver a oferentes
                            </a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Oferente:</strong> @Model.IdentificacionOferenteSeleccionado
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-experiencia">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Empresa</th>
                                    <th>Puesto desempeñado</th>
                                    <th>Fecha inicio</th>
                                    <th>Fecha fin</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ListaExperiencias)
                                {
                                    <tr>
                                        <td>@item.IdExperiencia</td>
                                        <td>@item.NombreEmpresa</td>
                                        <td>@item.PuestoDesempenado</td>
                                        <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                                        <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <div class="acciones-experiencia">
                                                <a href="/ExperienciaLaboral?idExperiencia=@item.IdExperiencia&identificacionOferente=@Model.IdentificacionOferenteSeleccionado"
                                                   class="btn-accion btn-editar">
                                                    Editar
                                                </a>

                                                <button type="button"
                                                        class="btn-accion btn-eliminar"
                                                        onclick="abrirModalEliminar('@item.IdExperiencia')">
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="modalExperiencia" class="modal" style="display: @(Model.MostrarFormulario ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.ModoEdicion ? "Editar Experiencia Laboral" : "Nueva Experiencia Laboral")</h3>

            <form method="post">
                <input type="hidden" asp-for="ModoEdicion" />
                <input type="hidden" asp-for="Experiencia.IdExperiencia" />
                <input type="hidden" asp-for="IdentificacionOferenteSeleccionado" />
                <input type="hidden" asp-for="Experiencia.IdentificacionOferente" />

                <label>Oferente</label>
                <input type="text" value="@Model.IdentificacionOferenteSeleccionado" readonly />

                <label>Nombre de la empresa</label>
                <input asp-for="Experiencia.NombreEmpresa" maxlength="100" required />

                <label>Puesto desempeñado</label>
                <input asp-for="Experiencia.PuestoDesempenado" maxlength="100" required />

                <label>Fecha de inicio</label>
                <input asp-for="Experiencia.FechaInicio" type="date" required />

                <label>Fecha de fin</label>
                <input asp-for="Experiencia.FechaFin" type="date" required />

                <div class="modal-buttons">
                    @if (Model.ModoEdicion)
                    {
                        <button type="submit" asp-page-handler="Actualizar" class="btn-guardar">
                            Actualizar
                        </button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Guardar" class="btn-guardar">
                            Guardar
                        </button>
                    }

                    <a href="/ExperienciaLaboral?identificacionOferente=@Model.IdentificacionOferenteSeleccionado" class="btn-cancelar">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div id="modalMensaje" class="modal" style="display: @(Model.MostrarMensajeModal ? "flex" : "none")">
        <div class="modal-content @(string.IsNullOrEmpty(Model.Error) ? "mensaje-exito" : "mensaje-error")">
            <h3>@(string.IsNullOrEmpty(Model.Error) ? "Operación exitosa" : "Error")</h3>
            <p>@(string.IsNullOrEmpty(Model.Error) ? Model.Mensaje : Model.Error)</p>

            <div class="modal-buttons">
                <a href="/ExperienciaLaboral?identificacionOferente=@Model.IdentificacionOferenteSeleccionado" class="btn-guardar">
                    Aceptar
                </a>
            </div>
        </div>
    </div>

    <div id="modalEliminar" class="modal">
        <div class="modal-content mensaje-confirmacion">
            <h3>Confirmar eliminación</h3>
            <p>¿Realmente desea eliminar el elemento seleccionado?</p>

            <form method="post" asp-page-handler="Eliminar">
                <input type="hidden" id="idExperienciaEliminar" name="idExperiencia" />
                <input type="hidden" name="IdentificacionOferenteSeleccionado" value="@Model.IdentificacionOferenteSeleccionado" />

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Sí</button>
                    <button type="button" class="btn-cancelar" onclick="cerrarModalEliminar()">No</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function abrirModalEliminar(idExperiencia) {
                document.getElementById("idExperienciaEliminar").value = idExperiencia;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {
                document.getElementById("modalEliminar").style.display = "none";
            }
    </script>

</body>
</html>
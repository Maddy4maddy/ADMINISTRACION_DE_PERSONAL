@page
@model AdministraciondePersonal.Pages.ExperienciaLaboralModel

@{
    Layout = null;
    ViewData["Title"] = "Registro Experiencia Laboral";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro Experiencia Laboral</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .acciones-experiencia {
                display: flex;
                gap: 6px;
                align-items: center;
                white-space: nowrap;
            }

                .acciones-experiencia form {
                    margin: 0;
                }

            .tabla-experiencia {
                font-size: 14px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Vizualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">
                    Usuario
                </span>

                <div class="user-avatar" id="userAvatar">
                    U
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Registro Experiencia Laboral
                </h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">
                        @Model.Mensaje
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        @(Model.ModoEdicion ? "Actualizar experiencia laboral" : "Nueva experiencia laboral")
                    </div>

                    <div class="card-body">

                        <form method="post">

                            <input type="hidden" asp-for="ModoEdicion" />
                            <input type="hidden" asp-for="Experiencia.IdExperiencia" />
                            <input type="hidden" asp-for="IdentificacionOferenteSeleccionado" />
                            <input type="hidden" asp-for="Experiencia.IdentificacionOferente" />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Oferente
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           value="@Model.IdentificacionOferenteSeleccionado"
                                           readonly />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Nombre de la empresa
                                    </label>

                                    <input asp-for="Experiencia.NombreEmpresa"
                                           maxlength="100"
                                           class="form-control" />
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Puesto desempeñado
                                    </label>

                                    <input asp-for="Experiencia.PuestoDesempenado"
                                           maxlength="100"
                                           class="form-control" />
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Fecha de inicio
                                    </label>

                                    <input asp-for="Experiencia.FechaInicio"
                                           type="date"
                                           class="form-control" />
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Fecha de fin
                                    </label>

                                    <input asp-for="Experiencia.FechaFin"
                                           type="date"
                                           class="form-control" />
                                </div>

                            </div>

                            @if (Model.ModoEdicion)
                            {
                                <button type="submit"
                                        asp-page-handler="Actualizar"
                                        class="btn btn-warning">
                                    Actualizar
                                </button>

                                <a asp-page="/ExperienciaLaboral"
                                   asp-route-identificacionOferente="@Model.IdentificacionOferenteSeleccionado"
                                   class="btn btn-secondary">
                                    Cancelar
                                </a>
                            }
                            else
                            {
                                <button type="submit"
                                        asp-page-handler="Guardar"
                                        class="btn btn-primary">
                                    Guardar
                                </button>
                            }

                            <a asp-page="/Oferentes"
                               class="btn btn-outline-secondary">
                                Volver a oferentes
                            </a>

                        </form>

                    </div>
                </div>

                <h4>
                    Historial de experiencia laboral
                </h4>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped tabla-experiencia">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Empresa</th>
                                <th>Puesto desempeñado</th>
                                <th>Fecha inicio</th>
                                <th>Fecha fin</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.ListaExperiencias)
                            {
                                <tr>
                                    <td>@item.IdExperiencia</td>

                                    <td>@item.NombreEmpresa</td>

                                    <td>@item.PuestoDesempenado</td>

                                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>

                                    <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>

                                    <td>
                                        <div class="acciones-experiencia">

                                            <a asp-page="/ExperienciaLaboral"
                                               asp-route-idExperiencia="@item.IdExperiencia"
                                               asp-route-identificacionOferente="@Model.IdentificacionOferenteSeleccionado"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?');">

                                                <input type="hidden"
                                                       name="idExperiencia"
                                                       value="@item.IdExperiencia" />

                                                <input type="hidden"
                                                       name="IdentificacionOferenteSeleccionado"
                                                       value="@Model.IdentificacionOferenteSeleccionado" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
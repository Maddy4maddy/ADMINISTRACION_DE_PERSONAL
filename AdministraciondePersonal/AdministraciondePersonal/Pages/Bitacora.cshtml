@page
@model AdministraciondePersonal.Pages.BitacoraModel
@{
    Layout = null;
    ViewData["Title"] = "Visualizar Bitácoras";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Visualizar Bitácoras</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .bitacora-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px;
                }

            .filtros-bitacora {
                background: #f8f9fa;
                border-radius: 20px;
                padding: 20px;
                margin-bottom: 25px;
                border: 1px solid #eeeeee;
            }

                .filtros-bitacora label {
                    color: #273a77;
                    font-weight: bold;
                    margin-bottom: 8px;
                }

                .filtros-bitacora .form-control,
                .filtros-bitacora .form-select {
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    padding: 10px;
                }

                    .filtros-bitacora .form-control:focus,
                    .filtros-bitacora .form-select:focus {
                        border-color: #FDB3CA;
                        outline: none;
                    }

            .btn-filtrar {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 10px 25px;
                border-radius: 15px;
                font-size: 14px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
            }

                .btn-filtrar:hover {
                    background-color: #80B0AA;
                }

            .btn-limpiar {
                background-color: #6c757d;
                color: white;
                border: none;
                padding: 10px 25px;
                border-radius: 15px;
                font-size: 14px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
                display: inline-block;
                text-align: center;
            }

                .btn-limpiar:hover {
                    background-color: #5a6268;
                    color: white;
                }

            .tabla-bitacora {
                width: 100%;
                border-collapse: collapse;
                overflow: hidden;
                border-radius: 20px;
                font-size: 14px;
            }

                .tabla-bitacora thead {
                    background-color: #80B0AA;
                    color: white;
                }

                .tabla-bitacora th,
                .tabla-bitacora td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eeeeee;
                    vertical-align: middle;
                }

                .tabla-bitacora tbody tr:hover {
                    background-color: #F9EAC1;
                }

            .ordenar-btn {
                text-decoration: none;
                color: white;
                margin-left: 5px;
            }

                .ordenar-btn:hover {
                    color: #FDB3CA;
                }

            /* Paginación  */
            .pagination {
                margin-top: 20px;
            }

                .pagination .page-link {
                    color: #273a77;
                }

                .pagination .active .page-link {
                    background-color: #273a77;
                    border-color: #273a77;
                    color: white;
                }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Visualizar Bitácoras</h2>

                <div class="bitacora-container">
                    <div class="header-acciones">
                        <h2>Bitácora de Acciones</h2>
                    </div>

                    <!-- Filtros -->
                    <div class="filtros-bitacora">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Filtrar por Usuario</label>
                                <select name="filtroUsuario" class="form-select" asp-for="FiltroUsuario" asp-items="Model.UsuariosList">
                                    <option value="">Todos los usuarios</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Buscar en Descripción</label>
                                <input type="text" name="filtroDescripcion" class="form-control" asp-for="FiltroDescripcion" placeholder="Texto a buscar...">
                            </div>
                            <div class="col-md-4 d-flex align-items-end gap-2">
                                <button type="submit" class="btn-filtrar">Filtrar</button>
                                <a href="/Bitacora" class="btn-limpiar">Limpiar filtros</a>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-bitacora">
                            <thead>
                                <tr>
                                    <th>
                                        Fecha
                                        <a asp-page="./Bitacora"
                                           asp-route-ordenarPor="FechaBitacora"
                                           asp-route-direccion="@(Model.Direccion == "DESC" ? "ASC" : "DESC")"
                                           asp-route-pagina="1"
                                           asp-route-filtroUsuario="@Model.FiltroUsuario"
                                           asp-route-filtroDescripcion="@Model.FiltroDescripcion"
                                           class="ordenar-btn">
                                            @(Model.OrdenarPor == "FechaBitacora" ? (Model.Direccion == "DESC" ? "▲" : "▼") : "▲▼")
                                        </a>
                                    </th>
                                    <th>
                                        Usuario
                                        <a asp-page="./Bitacora"
                                           asp-route-ordenarPor="Usuario"
                                           asp-route-direccion="@(Model.Direccion == "DESC" ? "ASC" : "DESC")"
                                           asp-route-pagina="1"
                                           asp-route-filtroUsuario="@Model.FiltroUsuario"
                                           asp-route-filtroDescripcion="@Model.FiltroDescripcion"
                                           class="ordenar-btn">
                                            @(Model.OrdenarPor == "Usuario" ? (Model.Direccion == "DESC" ? "▲" : "▼") : "▲▼")
                                        </a>
                                    </th>
                                    <th>Descripción de la Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Bitacoras)
                                {
                                    <tr>
                                        <td>@item.FechaBitacora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>@item.Usuario</td>
                                        <td>@item.DescripcionAccion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    <nav class="mt-4">
                        <ul class="pagination">
                            <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Bitacora"
                                   asp-route-pagina="@(Model.PaginaActual - 1)"
                                   asp-route-ordenarPor="@Model.OrdenarPor"
                                   asp-route-direccion="@Model.Direccion"
                                   asp-route-filtroUsuario="@Model.FiltroUsuario"
                                   asp-route-filtroDescripcion="@Model.FiltroDescripcion">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="/Bitacora"
                                       asp-route-pagina="@i"
                                       asp-route-ordenarPor="@Model.OrdenarPor"
                                       asp-route-direccion="@Model.Direccion"
                                       asp-route-filtroUsuario="@Model.FiltroUsuario"
                                       asp-route-filtroDescripcion="@Model.FiltroDescripcion">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Bitacora"
                                   asp-route-pagina="@(Model.PaginaActual + 1)"
                                   asp-route-ordenarPor="@Model.OrdenarPor"
                                   asp-route-direccion="@Model.Direccion"
                                   asp-route-filtroUsuario="@Model.FiltroUsuario"
                                   asp-route-filtroDescripcion="@Model.FiltroDescripcion">
                                    Siguiente
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - AdminPersonal</title>
    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="/Bienvenida" class="nav-link">Dashboard</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Oferentes</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Concursos</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Preparación Académica</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Experiencia Laboral</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Agendar Entrevista</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Bitácora</a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@ViewData["NombreUsuario"]</span>
                <div class="user-avatar" style="background-color: @ViewData["ColorAvatar"]">
                    @ViewData["InicialAvatar"]
                </div>
            </div>
        </div>
        <div class="page-container">
            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
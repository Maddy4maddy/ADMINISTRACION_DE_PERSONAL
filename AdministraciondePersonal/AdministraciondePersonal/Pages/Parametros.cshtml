@page
@model AdministraciondePersonal.Pages.ParametrosModel
@{
    Layout = null;
    ViewData["Title"] = "Administración de Parámetros";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <title>Parámetros</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link rel="stylesheet" href="~/css/pantallas.css">
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">

            <div class="user-info">

                <span class="user-name">
                    @Model.NombreUsuario
                </span>

                <div class="user-avatar"
                     style="background-color:@Model.ColorAvatar">

                    @Model.InicialAvatar

                </div>

            </div>

        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Administración de Parámetros
                </h2>

                <div class="crud-container">

                    <div class="header-acciones">

                        <h2>Listado de Parámetros</h2>

                        <button type="button"
                                class="btn-nuevo"
                                onclick="abrirModal()">
                            + Nuevo Parámetro
                        </button>

                    </div>

                    <div class="table-responsive">

                        <table class="tabla-pantallas">

                            <thead>

                                <tr>
                                    <th>ID</th>
                                    <th>Código</th>
                                    <th>Valor</th>
                                    <th>Acciones</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var p in Model.ListaParametros)
                                {
                                    <tr>

                                        <td>@p.IdParametro</td>

                                        <td>@p.Codigo</td>

                                        <td>@p.Valor</td>

                                        <td>

                                            <button type="button"
                                                    class="btn-accion btn-editar"
                                                    onclick="editarParametro(@p.IdParametro)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn-accion btn-eliminar"
                                                    onclick="abrirModalEliminar(@p.IdParametro)">
                                                Eliminar
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                        <div class="paginacion">

                            @if (Model.Pagina > 1)
                            {
                                <a href="/Parametros?Pagina=@(Model.Pagina - 1)"
                                   class="btn-editar">
                                    ← Anterior
                                </a>
                            }

                            <span>
                                Página @Model.Pagina de @Model.TotalPaginas
                            </span>

                            @if (Model.Pagina < Model.TotalPaginas)
                            {
                                <a href="/Parametros?Pagina=@(Model.Pagina + 1)"
                                   class="btn-editar">
                                    Siguiente →
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL CREAR / EDITAR -->

    <div id="modalParametro" class="modal">

        <div class="modal-content">

            <h3>Administración de Parámetros</h3>

            <form method="post">

                <input type="hidden"
                       asp-for="IdParametro" />

                <label>Código</label>

                <input asp-for="Codigo"
                       maxlength="100"
                       required />

                <label>Valor</label>

                <textarea asp-for="Valor"
                          maxlength="500"
                          required></textarea>

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModal()">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- MODAL ELIMINAR -->

    <div id="modalEliminar" class="modal">

        <div class="modal-content mensaje-confirmacion">

            <h3>Confirmar eliminación</h3>

            <p>
                ¿Realmente desea eliminar el parámetro seleccionado?
            </p>

            <form method="post"
                  asp-page-handler="Delete">

                <input type="hidden"
                       id="idEliminar"
                       name="id" />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Sí
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModalEliminar()">
                        No
                    </button>

                </div>

            </form>

        </div>

    </div>

    @if (Model.MostrarMensajeModal)
    {
        <div class="modal" style="display:flex;">

            <div class="modal-content @(Model.EsError ? "mensaje-error" : "mensaje-exito")">

                <h3>
                    @(Model.EsError ? "Error" : "Operación Exitosa")
                </h3>

                <p>
                    @Model.Mensaje
                </p>

                <div class="modal-buttons">

                    <a href="/Parametros"
                       class="btn-guardar">
                        Aceptar
                    </a>

                </div>

            </div>

        </div>
    }

    <script>

            function abrirModal() {

                document.querySelector("[name='IdParametro']").value = "0";
                document.querySelector("[name='Codigo']").value = "";
                document.querySelector("[name='Valor']").value = "";

                document.getElementById("modalParametro").style.display = "flex";
            }

            function cerrarModal() {

                document.getElementById("modalParametro").style.display = "none";
            }

            function editarParametro(id) {

                fetch(`/Parametros?handler=Parametro&id=${id}`)
                    .then(r => r.json())
                    .then(data => {

                        document.querySelector("[name='IdParametro']").value =
                            data.idParametro;

                        document.querySelector("[name='Codigo']").value =
                            data.codigo;

                        document.querySelector("[name='Valor']").value =
                            data.valor;

                        document.getElementById("modalParametro").style.display = "flex";
                    });
            }

            function abrirModalEliminar(id) {

                document.getElementById("idEliminar").value = id;

                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {

                document.getElementById("modalEliminar").style.display = "none";
            }

    </script>

</body>
</html>
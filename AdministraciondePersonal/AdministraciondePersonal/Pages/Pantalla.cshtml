@page
@model AdministraciondePersonal.Pages.PantallasModel
@{
    Layout = null;
    ViewData["Title"] = "Registro de Pantallas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Pantallas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link rel="stylesheet" href="~/css/pantallas.css?v=2">

</head>

<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPantallas</h3>
        </div>

        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>

    </div>
    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">Registro de Pantallas</h2>

                <div class="oferentes-container">

                    <div class="header-acciones">

                        <h2>Listado de Pantallas</h2>

                        <button type="button"
                                class="btn-nuevo"
                                onclick="abrirModal()">
                            + Nueva Pantalla
                        </button>

                    </div>

                    <div class="table-responsive">

                        <table class="tabla-pantallas">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre Pantalla</th>
                                    <th>Ruta</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var p in Model.ListaPantallas)
                                {
                                    <tr>

                                        <td>@p.IdPantalla</td>

                                        <td>@p.NombrePantalla</td>

                                        <td>@p.Ruta</td>

                                        <td>

                                            <button type="button"
                                                    class="btn-accion btn-editar"
                                                    onclick="editarPantalla(@p.IdPantalla)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn-accion btn-eliminar"
                                                    onclick="abrirModalEliminar(@p.IdPantalla)">
                                                Eliminar
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                        @if (Model.TotalPaginas > 1)
                        {
                            <div class="modal-buttons"
                                 style="margin-top:20px; justify-content:center;">

                                @if (Model.PaginaActual > 1)
                                {
                                    <a href="/Pantalla?PaginaActual=@(Model.PaginaActual - 1)"
                                       class="btn-cancelar">
                                        ← Anterior
                                    </a>
                                }

                                <span style="padding:10px 15px;">
                                    Página @Model.PaginaActual de @Model.TotalPaginas
                                </span>

                                @if (Model.PaginaActual < Model.TotalPaginas)
                                {
                                    <a href="/Pantalla?PaginaActual=@(Model.PaginaActual + 1)"
                                       class="btn-guardar">
                                        Siguiente →
                                    </a>
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MODAL CREAR / EDITAR -->

    <div id="modalPantalla" class="modal">

        <div class="modal-content">

            <h3>Administración de Pantallas</h3>

            <form method="post">

                <input type="hidden" asp-for="IdPantalla" />

                <label>Nombre de la Pantalla</label>

                <input asp-for="NombrePantalla"
                       maxlength="100"
                       required />

                <label>Ruta</label>

                <input asp-for="Ruta"
                       maxlength="100"
                       required />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModal()">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- MODAL ELIMINAR -->

    <div id="modalEliminar" class="modal">

        <div class="modal-content mensaje-confirmacion">

            <h3>Confirmar eliminación</h3>

            <p>¿Realmente desea eliminar la pantalla seleccionada?</p>

            <form method="post"
                  asp-page-handler="Delete">

                <input type="hidden"
                       id="idEliminar"
                       name="id" />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Sí
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModalEliminar()">
                        No
                    </button>

                </div>

            </form>

        </div>

    </div>


    @if (Model.MostrarMensajeModal)
    {
        <div class="modal" style="display:flex;">

            <div class="modal-content @(Model.EsError ? "mensaje-error" : "mensaje-exito")">

                <h3>
                    @(Model.EsError ? "Error" : "Operación Exitosa")
                </h3>

                <p>@Model.Mensaje</p>

                <div class="modal-buttons">

                    <a href="/Pantalla"
                       class="btn-guardar">
                        Aceptar
                    </a>

                </div>

            </div>

        </div>
    }


    <script>

            function abrirModal() {

                document.querySelector("[name='IdPantalla']").value = "0";
                document.querySelector("[name='NombrePantalla']").value = "";
                document.querySelector("[name='Ruta']").value = "";

                document.getElementById("modalPantalla").style.display = "flex";
            }

            function cerrarModal() {

                document.getElementById("modalPantalla").style.display = "none";
            }

            function editarPantalla(id) {

                fetch(`/Pantalla?handler=Pantalla&id=${id}`)
                    .then(r => r.json())
                    .then(data => {

                        document.querySelector("[name='IdPantalla']").value =
                            data.idPantalla;

                        document.querySelector("[name='NombrePantalla']").value =
                            data.nombrePantalla;

                        document.querySelector("[name='Ruta']").value =
                            data.ruta;

                        document.getElementById("modalPantalla").style.display = "flex";
                    });
            }

            function abrirModalEliminar(id) {

                document.getElementById("idEliminar").value = id;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {

                document.getElementById("modalEliminar").style.display = "none";
            }

    </script>

</body>
</html>
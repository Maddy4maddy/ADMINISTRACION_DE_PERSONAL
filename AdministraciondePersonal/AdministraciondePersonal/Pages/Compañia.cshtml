@page
@model AdministraciondePersonal.Pages.CompaniasModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Compañías</title>


    <link rel="stylesheet" href="~/css/plantillaGlobal.css" />
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/Roles" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Usuarios" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item active">
                <a href="/Companias" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Bitacora" class="nav-link">
                    <span>Visualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Parametros" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/Pantalla" class="nav-link">
                    <span>Administración Pantallas</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/InstitucionesEducativas" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <!-- CONTENIDO -->
    <div class="main-content">

        <div class="page-container">

            <div class="crud-container">

                <h2 class="crud-title">
                    Administración de Compañías
                </h2>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="mensaje-alerta">
                        @TempData["Mensaje"]
                    </div>
                }

                <button class="btn-nuevo" onclick="abrirModal()">
                    + Nueva Compañía
                </button>

                <table class="table-roles">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ListaCompanias)
                        {
                            <tr>

                                <td>@item.IdCompania</td>

                                <td>@item.NombreCompania</td>

                                <td>

                                    <button type="button"
                                            class="btn-editar"
                                            onclick="editarCompania('@item.IdCompania','@item.NombreCompania')">
                                        Modificar
                                    </button>

                                    <form method="post"
                                          asp-page-handler="Eliminar"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.IdCompania" />

                                        <button type="submit"
                                                class="btn-eliminar"
                                                onclick="return confirm('¿Desea eliminar esta compañía?')">
                                            Eliminar
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- MODAL -->
    <div id="modalCompania" class="modal">

        <div class="modal-content">

            <h3 id="tituloModal">
                Nueva Compañía
            </h3>

            <form method="post" asp-page-handler="Guardar">

                <input type="hidden"
                       asp-for="Compania.IdCompania"
                       id="IdCompania" />

                <label>Nombre *</label>

                <input asp-for="Compania.NombreCompania"
                       id="NombreCompania"
                       maxlength="150"
                       required />

                <div class="modal-buttons">

                    <button type="submit" class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModal()">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>

    </div>

    <script>

            function abrirModal() {
                document.getElementById("tituloModal").innerText =
                    "Nueva Compañía";

                document.getElementById("IdCompania").value = "";
                document.getElementById("NombreCompania").value = "";

                document.getElementById("modalCompania").style.display =
                    "flex";
            }

            function cerrarModal() {
                document.getElementById("modalCompania").style.display =
                    "none";
            }

            function editarCompania(id, nombre) {

                document.getElementById("tituloModal").innerText =
                    "Modificar Compañía";

                document.getElementById("IdCompania").value = id;
                document.getElementById("NombreCompania").value = nombre;

                document.getElementById("modalCompania").style.display =
                    "flex";
            }

    </script>

</body>
</html>
@page
@model AdministraciondePersonal.Pages.CompaniasModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Compañías</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link rel="stylesheet" href="~/css/pantallas.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>
    </div>

<div class="main-content">

    <div class="topbar">

        <div class="user-info">

            <span class="user-name" id="nombreUsuario">
                @Model.NombreUsuario
            </span>

            <div class="user-avatar" id="userAvatar" style="background-color: @Model.ColorAvatar">
                @Model.InicialAvatar
            </div>

        </div>

    </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Administración de Compañías
                </h2>

                <div class="oferentes-container">

                    <div class="header-acciones">

                        <h2>Listado de Compañías</h2>

                        <button type="button"
                                class="btn-nuevo"
                                onclick="abrirModal()">
                            + Nueva Compañía
                        </button>

                    </div>

                    <div class="table-responsive">

                        <table class="tabla-pantallas">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.ListaCompanias)
                                {
                                    <tr>

                                        <td>@item.IdCompania</td>

                                        <td>@item.NombreCompania</td>

                                        <td>

                                            <button type="button"
                                                    class="btn-accion btn-editar"
                                                    onclick="editarCompania(@item.IdCompania)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn-accion btn-eliminar"
                                                    onclick="abrirModalEliminar(@item.IdCompania)">
                                                Eliminar
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                        @if (Model.TotalPaginas > 1)
                        {
                            <div class="mt-3 d-flex justify-content-center align-items-center gap-2">

                                @if (Model.PaginaActual > 1)
                                {
                                    <a href="/Compañia?pagina=@(Model.PaginaActual - 1)"
                                       class="btn-editar">
                                        ← Anterior
                                    </a>
                                }

                                <span>
                                    Página @Model.PaginaActual de @Model.TotalPaginas
                                </span>

                                @if (Model.PaginaActual < Model.TotalPaginas)
                                {
                                    <a href="/Compañia?pagina=@(Model.PaginaActual + 1)"
                                       class="btn-editar">
                                        Siguiente →
                                    </a>
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MODAL CREAR / EDITAR -->

    <div id="modalCompania" class="modal">

        <div class="modal-content">

            <h3 id="tituloModal">
                Administración de Compañías
            </h3>

            <form method="post"
                  asp-page-handler="Guardar">

                <input type="hidden"
                       asp-for="Compania.IdCompania"
                       id="IdCompania" />

                <label>Nombre Compañía</label>

                <input type="text"
                       asp-for="Compania.NombreCompania"
                       id="NombreCompania"
                       maxlength="150"
                       required />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModal()">
                        Cancelar
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- MODAL ELIMINAR -->

    <div id="modalEliminar" class="modal">

        <div class="modal-content mensaje-confirmacion">

            <h3>Confirmar eliminación</h3>

            <p>
                ¿Realmente desea eliminar la compañía seleccionada?
            </p>

            <form method="post"
                  asp-page-handler="Eliminar">

                <input type="hidden"
                       id="idEliminar"
                       name="id" />

                <div class="modal-buttons">

                    <button type="submit"
                            class="btn-guardar">
                        Sí
                    </button>

                    <button type="button"
                            class="btn-cancelar"
                            onclick="cerrarModalEliminar()">
                        No
                    </button>

                </div>

            </form>

        </div>

    </div>


    @if (Model.MostrarMensajeModal)
    {
        bool esError = !string.IsNullOrEmpty(Model.Error);

        <div class="modal" style="display:flex;">

            <div class="modal-content @(esError ? "mensaje-error" : "mensaje-exito")">

                <h3>
                    @(esError ? "Error" : "Operación Exitosa")
                </h3>

                <p>
                    @(esError ? Model.Error : Model.Mensaje)
                </p>

                <div class="modal-buttons">

                    <a href="/Compañia"
                       class="btn-guardar">
                        Aceptar
                    </a>

                </div>

            </div>

        </div>
    }


    <script>

            function abrirModal() {

                document.getElementById("tituloModal").innerText =
                    "Nueva Compañía";

                document.getElementById("IdCompania").value = "0";

                document.getElementById("NombreCompania").value = "";

                document.getElementById("modalCompania").style.display =
                    "flex";
            }

            function cerrarModal() {

                document.getElementById("modalCompania").style.display =
                    "none";
            }

            function editarCompania(id) {

                fetch(`/Compañia?handler=Compania&id=${id}`)
                    .then(r => r.json())
                    .then(data => {

                        document.getElementById("tituloModal").innerText =
                            "Modificar Compañía";

                        document.getElementById("IdCompania").value =
                            data.idCompania;

                        document.getElementById("NombreCompania").value =
                            data.nombreCompania;

                        document.getElementById("modalCompania").style.display =
                            "flex";
                    });
            }

            function abrirModalEliminar(id) {

                document.getElementById("idEliminar").value = id;

                document.getElementById("modalEliminar").style.display =
                    "flex";
            }

            function cerrarModalEliminar() {

                document.getElementById("modalEliminar").style.display =
                    "none";
            }

    </script>

</body>
</html>
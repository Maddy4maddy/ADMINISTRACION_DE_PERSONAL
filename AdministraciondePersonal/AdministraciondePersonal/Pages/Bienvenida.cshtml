@page
@model AdministraciondePersonal.Pages.BienvenidaModel
@{
    Layout = null;
    ViewData["Title"] = "Bienvenido - Sistema Administración de Personal";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido - Sistema Administración de Personal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>

            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">

            <div class="user-info">

                <span class="user-name" id="nombreUsuario">
                    @Model.NombreUsuario
                </span>

                <div class="user-avatar"
                     id="userAvatar"
                     style="background-color: @Model.ColorAvatar">

                    @Model.InicialAvatar

                </div>

            </div>

        </div>

        <div class="page-container">

            <div class="welcome-card">

                <h2>
                    Bienvenido,
                    <span id="nombreCompleto">
                        @Model.NombreCompleto
                    </span>
                </h2>

                <div class="logo-empresa">

                    <img src="~/css/images/logoempresa.png"
                         alt="Logo empresa"
                         onerror="this.style.display='none'">

                </div>

            </div>

        </div>

    </div>

</body>
</html>
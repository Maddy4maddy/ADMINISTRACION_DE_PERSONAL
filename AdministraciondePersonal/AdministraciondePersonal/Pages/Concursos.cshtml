@page
@model AdministraciondePersonal.Pages.ConcursosModel

@{
    Layout = null;
    ViewData["Title"] = "Registro de Concursos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Concursos</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .concursos-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px;
                }

            .btn-nuevo {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 15px;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
            }

                .btn-nuevo:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .tabla-concursos {
                width: 100%;
                border-collapse: collapse;
                overflow: hidden;
                border-radius: 20px;
                font-size: 14px;
            }

                .tabla-concursos thead {
                    background-color: #80B0AA;
                    color: white;
                }

                .tabla-concursos th,
                .tabla-concursos td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eeeeee;
                    vertical-align: middle;
                }

                .tabla-concursos tbody tr:hover {
                    background-color: #F9EAC1;
                }

            .acciones-concurso {
                display: flex;
                gap: 8px;
                align-items: center;
                justify-content: center;
                white-space: nowrap;
            }

                .acciones-concurso form {
                    margin: 0;
                }

            .btn-accion {
                background: none;
                border: none;
                font-size: 16px;
                cursor: pointer;
                margin: 0 3px;
                padding: 5px 8px;
                border-radius: 10px;
                transition: 0.3s;
                text-decoration: none;
                display: inline-block;
                white-space: nowrap;
            }

            .btn-editar {
                color: #273a77;
            }

                .btn-editar:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .btn-eliminar {
                color: #d9534f;
            }

                .btn-eliminar:hover {
                    background-color: #d9534f;
                    color: white;
                }

            .btn-estado {
                color: #315855;
            }

                .btn-estado:hover {
                    background-color: #315855;
                    color: white;
                }

            .estado-vigente {
                background-color: #2ECC71;
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 12px;
            }

            .estado-vencido {
                background-color: #E74C3C;
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 12px;
            }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: white;
                border-radius: 30px;
                padding: 30px;
                width: 90%;
                max-width: 700px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.2);
                max-height: 90vh;
                overflow-y: auto;
            }

                .modal-content h3 {
                    color: #273a77;
                    margin-bottom: 20px;
                    font-size: 24px;
                }

                .modal-content label {
                    display: block;
                    margin-bottom: 5px;
                    color: #273a77;
                    font-weight: bold;
                }

                .modal-content input,
                .modal-content select {
                    width: 100%;
                    padding: 10px;
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    font-size: 14px;
                    margin-bottom: 15px;
                    outline: none;
                }

                    .modal-content input:focus,
                    .modal-content select:focus {
                        border-color: #FDB3CA;
                    }

            .modal-buttons {
                display: flex;
                gap: 15px;
                justify-content: flex-end;
                margin-top: 20px;
            }

                .modal-buttons button,
                .modal-buttons a {
                    padding: 10px 20px;
                    border-radius: 15px;
                    border: none;
                    cursor: pointer;
                    font-weight: bold;
                    text-decoration: none;
                }

            .btn-guardar {
                background-color: #273a77;
                color: white;
            }

            .btn-cancelar {
                background-color: #ccc;
                color: #333;
            }

            .mensaje-exito h3 {
                color: #2ECC71;
            }

            .mensaje-error h3 {
                color: #E74C3C;
            }

            .mensaje-confirmacion h3 {
                color: #273a77;
            }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item"><a href="/Bienvenida" class="nav-link">Dashboard</a></li>
            <li class="nav-item"><a href="/Roles" class="nav-link">Administración Roles</a></li>
            <li class="nav-item"><a href="/Usuarios" class="nav-link">Administración Usuarios</a></li>
            <li class="nav-item"><a href="/Oferentes" class="nav-link">Registro Oferentes</a></li>
            <li class="nav-item"><a href="/Concursos" class="nav-link">Registro Concursos</a></li>
            <li class="nav-item"><a href="/PreparacionAcademica" class="nav-link">Registro Preparación Académica</a></li>
            <li class="nav-item"><a href="/ExperienciaLaboral" class="nav-link">Experiencia Laboral</a></li>
            <li class="nav-item"><a href="/Entrevistas" class="nav-link">Agendar Entrevista</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Contratar Empleado</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Requisitos de Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Áreas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Acciones de Personal</a></li>
            <li class="nav-item"><a href="/Bitacora" class="nav-link">Visualizar Bitácoras</a></li>
            <li class="nav-item"><a href="/Parametros" class="nav-link">Administración Parámetros</a></li>
            <li class="nav-item"><a href="/Compañia" class="nav-link">Administración Compañías</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Cargar Datos de Ubicación</a></li>
            <li class="nav-item"><a href="/Pantalla" class="nav-link">Administracion de Pantallas</a></li>
            <li class="nav-item"><a href="/InstitucionesEducativas" class="nav-link">Administración Instituciones Educativas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Módulos</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Registro de Concursos</h2>

                <div class="concursos-container">
                    <div class="header-acciones">
                        <h2>Listado de Concursos</h2>
                        <a href="/Concursos?nuevo=true" class="btn-nuevo">+ Nuevo Concurso</a>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-concursos">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Fecha inicio</th>
                                    <th>Fecha fin</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ListaConcursos)
                                {
                                    <tr>
                                        <td>@item.CodigoConcurso</td>
                                        <td>@item.NombreConcurso</td>
                                        <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                                        <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (item.Estado == "Vigente")
                                            {
                                                <span class="estado-vigente">Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="estado-vencido">Vencido</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="acciones-concurso">
                                                <a href="/Concursos?codigoConcurso=@item.CodigoConcurso"
                                                   class="btn-accion btn-editar">
                                                    Editar
                                                </a>

                                                <button type="button"
                                                        class="btn-accion btn-eliminar"
                                                        onclick="abrirModalEliminar('@item.CodigoConcurso')">
                                                    Eliminar
                                                </button>

                                                <form method="post" asp-page-handler="CambiarEstado">
                                                    <input type="hidden" name="codigoConcurso" value="@item.CodigoConcurso" />
                                                    <button type="submit" class="btn-accion btn-estado">
                                                        @(item.Estado == "Vigente" ? "Marcar vencido" : "Marcar vigente")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="modalConcurso" class="modal" style="display: @(Model.MostrarFormulario ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.ModoEdicion ? "Editar Concurso" : "Nuevo Concurso")</h3>

            <form method="post">
                <input type="hidden" asp-for="ModoEdicion" />

                <label>Código del concurso</label>
                <input asp-for="Concurso.CodigoConcurso"
                       type="number"
                       readonly="@Model.ModoEdicion"
                       required />

                <label>Nombre del concurso</label>
                <input asp-for="Concurso.NombreConcurso" required />

                <label>Fecha de inicio</label>
                <input asp-for="Concurso.FechaInicio" type="date" required />

                <label>Fecha de fin</label>
                <input asp-for="Concurso.FechaFin" type="date" required />

                <label>Estado</label>
                @if (Model.ModoEdicion)
                {
                    <select asp-for="Concurso.Estado" required>
                        <option value="Vigente">Vigente</option>
                        <option value="Vencido">Vencido</option>
                    </select>
                }
                else
                {
                    <input type="text" value="Vigente" readonly />
                    <input type="hidden" asp-for="Concurso.Estado" value="Vigente" />
                }

                <div class="modal-buttons">
                    @if (Model.ModoEdicion)
                    {
                        <button type="submit" asp-page-handler="Actualizar" class="btn-guardar">
                            Actualizar
                        </button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Guardar" class="btn-guardar">
                            Guardar
                        </button>
                    }

                    <a href="/Concursos" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <div id="modalMensaje" class="modal" style="display: @(Model.MostrarMensajeModal ? "flex" : "none")">
        <div class="modal-content @(string.IsNullOrEmpty(Model.Error) ? "mensaje-exito" : "mensaje-error")">
            <h3>@(string.IsNullOrEmpty(Model.Error) ? "Operación exitosa" : "Error")</h3>
            <p>@(string.IsNullOrEmpty(Model.Error) ? Model.Mensaje : Model.Error)</p>

            <div class="modal-buttons">
                <a href="/Concursos" class="btn-guardar">Aceptar</a>
            </div>
        </div>
    </div>

    <div id="modalEliminar" class="modal">
        <div class="modal-content mensaje-confirmacion">
            <h3>Confirmar eliminación</h3>
            <p>¿Realmente desea eliminar el elemento seleccionado?</p>

            <form method="post" asp-page-handler="Eliminar">
                <input type="hidden" id="codigoConcursoEliminar" name="codigoConcurso" />

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Sí</button>
                    <button type="button" class="btn-cancelar" onclick="cerrarModalEliminar()">No</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function abrirModalEliminar(codigoConcurso) {
                document.getElementById("codigoConcursoEliminar").value = codigoConcurso;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {
                document.getElementById("modalEliminar").style.display = "none";
            }
    </script>

</body>
</html>
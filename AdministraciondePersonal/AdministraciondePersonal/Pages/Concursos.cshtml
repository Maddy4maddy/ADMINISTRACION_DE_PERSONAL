@page
@model AdministraciondePersonal.Pages.ConcursosModel

@{
    Layout = null;
    ViewData["Title"] = "Registro de Concursos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Concursos</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .acciones-concurso {
                display: flex;
                gap: 6px;
                align-items: center;
                white-space: nowrap;
            }

                .acciones-concurso form {
                    margin: 0;
                }

            .tabla-concursos {
                font-size: 14px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Vizualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">
                    Usuario
                </span>

                <div class="user-avatar" id="userAvatar">
                    U
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Registro de Concursos
                </h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">
                        @Model.Mensaje
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        @(Model.ModoEdicion ? "Actualizar concurso" : "Nuevo concurso")
                    </div>

                    <div class="card-body">

                        <form method="post">

                            <input type="hidden" asp-for="ModoEdicion" />

                            <div class="row">

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Código del concurso
                                    </label>

                                    <input asp-for="Concurso.CodigoConcurso"
                                           type="number"
                                           class="form-control"
                                           readonly="@Model.ModoEdicion" />
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Nombre del concurso
                                    </label>

                                    <input asp-for="Concurso.NombreConcurso"
                                           class="form-control" />
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Fecha de inicio
                                    </label>

                                    <input asp-for="Concurso.FechaInicio"
                                           type="date"
                                           class="form-control" />
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">
                                        Fecha de fin
                                    </label>

                                    <input asp-for="Concurso.FechaFin"
                                           type="date"
                                           class="form-control" />
                                </div>

                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Estado
                                </label>

                                @if (Model.ModoEdicion)
                                {
                                    <select asp-for="Concurso.Estado"
                                            class="form-select">

                                        <option value="Vigente">
                                            Vigente
                                        </option>

                                        <option value="Vencido">
                                            Vencido
                                        </option>

                                    </select>
                                }
                                else
                                {
                                    <input type="text"
                                           class="form-control"
                                           value="Vigente"
                                           readonly />

                                    <input type="hidden"
                                           asp-for="Concurso.Estado"
                                           value="Vigente" />
                                }
                            </div>

                            @if (Model.ModoEdicion)
                            {
                                <button type="submit"
                                        asp-page-handler="Actualizar"
                                        class="btn btn-warning">
                                    Actualizar
                                </button>

                                <a href="/Concursos"
                                   class="btn btn-secondary">
                                    Cancelar
                                </a>
                            }
                            else
                            {
                                <button type="submit"
                                        asp-page-handler="Guardar"
                                        class="btn btn-primary">
                                    Guardar
                                </button>
                            }

                        </form>

                    </div>
                </div>

                <h4>
                    Lista de Concursos
                </h4>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped tabla-concursos">

                        <thead>

                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Fecha inicio</th>
                                <th>Fecha fin</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.ListaConcursos)
                            {
                                <tr>

                                    <td>@item.CodigoConcurso</td>

                                    <td>@item.NombreConcurso</td>

                                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>

                                    <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>

                                    <td>@item.Estado</td>

                                    <td>
                                        <div class="acciones-concurso">

                                            <a asp-page="/Concursos"
                                               asp-route-codigoConcurso="@item.CodigoConcurso"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?');">

                                                <input type="hidden"
                                                       name="codigoConcurso"
                                                       value="@item.CodigoConcurso" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                            <form method="post"
                                                  asp-page-handler="CambiarEstado">

                                                <input type="hidden"
                                                       name="codigoConcurso"
                                                       value="@item.CodigoConcurso" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-info">
                                                    @(item.Estado == "Vigente" ? "Marcar vencido" : "Marcar vigente")
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
@page
@model AdministraciondePersonal.Pages.OferentesModel

@{
    Layout = null;
    ViewData["Title"] = "Registro de Oferentes";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Oferentes</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link rel="stylesheet" href="~/css/pantallas.css">

    <style>
            .oferentes-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px;
                }

            .btn-nuevo {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 15px;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
            }

                .btn-nuevo:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .tabla-oferentes {
                width: 100%;
                border-collapse: collapse;
                overflow: hidden;
                border-radius: 20px;
                font-size: 14px;
            }

                .tabla-oferentes thead {
                    background-color: #80B0AA;
                    color: white;
                }

                .tabla-oferentes th,
                .tabla-oferentes td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eeeeee;
                    vertical-align: middle;
                }

                .tabla-oferentes tbody tr:hover {
                    background-color: #F9EAC1;
                }

            .acciones-oferente {
                display: flex;
                gap: 8px;
                align-items: center;
                justify-content: center;
                white-space: nowrap;
            }

            .btn-accion {
                background: none;
                border: none;
                font-size: 16px;
                cursor: pointer;
                margin: 0 3px;
                padding: 5px 8px;
                border-radius: 10px;
                transition: 0.3s;
                text-decoration: none;
                display: inline-block;
                white-space: nowrap;
            }

            .btn-editar {
                color: #273a77;
            }

                .btn-editar:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .btn-eliminar {
                color: #d9534f;
            }

                .btn-eliminar:hover {
                    background-color: #d9534f;
                    color: white;
                }

            .btn-secundario {
                color: #315855;
            }

                .btn-secundario:hover {
                    background-color: #315855;
                    color: white;
                }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: white;
                border-radius: 30px;
                padding: 30px;
                width: 90%;
                max-width: 850px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.2);
                max-height: 90vh;
                overflow-y: auto;
            }

                .modal-content h3 {
                    color: #273a77;
                    margin-bottom: 20px;
                    font-size: 24px;
                }

                .modal-content label {
                    display: block;
                    margin-bottom: 5px;
                    color: #273a77;
                    font-weight: bold;
                }

                .modal-content input,
                .modal-content select {
                    width: 100%;
                    padding: 10px;
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    font-size: 14px;
                    margin-bottom: 15px;
                    outline: none;
                }

                    .modal-content input:focus,
                    .modal-content select:focus {
                        border-color: #FDB3CA;
                    }

            .modal-buttons {
                display: flex;
                gap: 15px;
                justify-content: flex-end;
                margin-top: 20px;
            }

                .modal-buttons button,
                .modal-buttons a {
                    padding: 10px 20px;
                    border-radius: 15px;
                    border: none;
                    cursor: pointer;
                    font-weight: bold;
                    text-decoration: none;
                }

            .btn-guardar {
                background-color: #273a77;
                color: white;
            }

            .btn-cancelar {
                background-color: #ccc;
                color: #333;
            }

            .mensaje-exito h3 {
                color: #2ECC71;
            }

            .mensaje-error h3 {
                color: #E74C3C;
            }

            .mensaje-confirmacion h3 {
                color: #273a77;
            }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">
                    <a href="@pantalla.Ruta" class="nav-link">
                        <span>@pantalla.NombrePantalla</span>
                    </a>
                </li>
            }
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color:@Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Registro de Oferentes</h2>

                <div class="oferentes-container">
                    <div class="header-acciones">
                        <h2>Listado de Oferentes</h2>
                        <a href="/Oferentes?nuevo=true" class="btn-nuevo">+ Nuevo Oferente</a>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-oferentes">
                            <thead>
                                <tr>
                                    <th>Identificación</th>
                                    <th>Tipo</th>
                                    <th>Nombre</th>
                                    <th>Fecha nacimiento</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                    <th>Concurso</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ListaOferentes)
                                {
                                    <tr>
                                        <td>@item.Identificacion</td>
                                        <td>@item.TipoIdentificacion</td>
                                        <td>@item.NombreCompleto</td>
                                        <td>@item.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                                        <td>@item.Correo</td>
                                        <td>@item.Telefono</td>
                                        <td>@item.NombreConcurso</td>
                                        <td>
                                            <div class="acciones-oferente">
                                                <a href="/Oferentes?identificacion=@item.Identificacion"
                                                   class="btn-accion btn-editar">
                                                    Editar
                                                </a>

                                                <a href="/PreparacionAcademica?identificacionOferente=@item.Identificacion"
                                                   class="btn-accion btn-secundario">
                                                    Preparación académica
                                                </a>

                                                <a href="/ExperienciaLaboral?identificacionOferente=@item.Identificacion"
                                                   class="btn-accion btn-secundario">
                                                    Experiencia laboral
                                                </a>

                                                <button type="button"
                                                        class="btn-accion btn-eliminar"
                                                        onclick="abrirModalEliminar('@item.Identificacion')">
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="modalOferente" class="modal" style="display: @(Model.MostrarFormulario ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.ModoEdicion ? "Editar Oferente" : "Nuevo Oferente")</h3>

            <form method="post">
                <input type="hidden" asp-for="ModoEdicion" />

                <label>Identificación</label>
                <input asp-for="Oferente.Identificacion" readonly="@Model.ModoEdicion" required />

                <label>Tipo de identificación</label>
                <select asp-for="Oferente.TipoIdentificacion" required>
                    <option value="">Seleccione</option>
                    <option value="Cédula de identidad">Cédula de identidad</option>
                    <option value="DIMEX">DIMEX</option>
                    <option value="Pasaporte">Pasaporte</option>
                </select>

                <label>Nombre completo</label>
                <input asp-for="Oferente.NombreCompleto" required />

                <label>Fecha nacimiento</label>
                <input asp-for="Oferente.FechaNacimiento" type="date" required />

                <label>Correo</label>
                <input asp-for="Oferente.Correo" type="email" required />

                <label>Teléfono</label>
                <input asp-for="Oferente.Telefono" required />

                <label>Concurso</label>
                <select asp-for="Oferente.CodigoConcurso" required>
                    <option value="0">Seleccione un concurso</option>

                    @foreach (var concurso in Model.Concursos)
                    {
                        <option value="@concurso.CodigoConcurso">
                            @concurso.NombreConcurso
                        </option>
                    }
                </select>

                <div class="modal-buttons">
                    @if (Model.ModoEdicion)
                    {
                        <button type="submit" asp-page-handler="Actualizar" class="btn-guardar">
                            Actualizar
                        </button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Guardar" class="btn-guardar">
                            Guardar
                        </button>
                    }

                    <a href="/Oferentes" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <div id="modalMensaje" class="modal" style="display: @(Model.MostrarMensajeModal ? "flex" : "none")">
        <div class="modal-content @(string.IsNullOrEmpty(Model.Error) ? "mensaje-exito" : "mensaje-error")">
            <h3>@(string.IsNullOrEmpty(Model.Error) ? "Operación exitosa" : "Error")</h3>
            <p>@(string.IsNullOrEmpty(Model.Error) ? Model.Mensaje : Model.Error)</p>

            <div class="modal-buttons">
                <a href="/Oferentes" class="btn-guardar">Aceptar</a>
            </div>
        </div>
    </div>

    <div id="modalEliminar" class="modal">
        <div class="modal-content mensaje-confirmacion">
            <h3>Confirmar eliminación</h3>
            <p>¿Realmente desea eliminar el elemento seleccionado?</p>

            <form method="post" asp-page-handler="Eliminar">
                <input type="hidden" id="identificacionEliminar" name="identificacion" />

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Sí</button>
                    <button type="button" class="btn-cancelar" onclick="cerrarModalEliminar()">No</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function abrirModalEliminar(identificacion) {
                document.getElementById("identificacionEliminar").value = identificacion;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {
                document.getElementById("modalEliminar").style.display = "none";
            }
    </script>

</body>
</html>
@page
@model AdministraciondePersonal.Pages.OferentesModel

@{
    Layout = null;
    ViewData["Title"] = "Registro de Oferentes";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Oferentes</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .acciones-oferente {
                display: flex;
                gap: 6px;
                align-items: center;
                white-space: nowrap;
            }

                .acciones-oferente form {
                    margin: 0;
                }

            .tabla-oferentes {
                font-size: 14px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Vizualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">
                    Usuario
                </span>

                <div class="user-avatar" id="userAvatar">
                    U
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">
                    Registro de Oferentes
                </h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">
                        @Model.Mensaje
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        @(Model.ModoEdicion ? "Actualizar oferente" : "Nuevo oferente")
                    </div>

                    <div class="card-body">

                        <form method="post">

                            <input type="hidden" asp-for="ModoEdicion" />

                            <div class="row">

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">
                                        Identificación
                                    </label>

                                    <input asp-for="Oferente.Identificacion"
                                           class="form-control"
                                           readonly="@Model.ModoEdicion" />
                                </div>

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Tipo de identificación
                                    </label>

                                    <select asp-for="Oferente.TipoIdentificacion"
                                            class="form-select">

                                        <option value="">
                                            Seleccione
                                        </option>

                                        <option value="Cédula de identidad">
                                            Cédula de identidad
                                        </option>

                                        <option value="DIMEX">
                                            DIMEX
                                        </option>

                                        <option value="Pasaporte">
                                            Pasaporte
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Nombre completo
                                    </label>

                                    <input asp-for="Oferente.NombreCompleto"
                                           class="form-control" />

                                </div>

                            </div>

                            <div class="row">

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Fecha nacimiento
                                    </label>

                                    <input asp-for="Oferente.FechaNacimiento"
                                           type="date"
                                           class="form-control" />

                                </div>

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Correo
                                    </label>

                                    <input asp-for="Oferente.Correo"
                                           class="form-control" />

                                </div>

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Teléfono
                                    </label>

                                    <input asp-for="Oferente.Telefono"
                                           class="form-control" />

                                </div>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Concurso
                                </label>

                                <select asp-for="Oferente.CodigoConcurso"
                                        class="form-select">

                                    <option value="0">
                                        Seleccione un concurso
                                    </option>

                                    @foreach (var concurso in Model.Concursos)
                                    {
                                        <option value="@concurso.CodigoConcurso">
                                            @concurso.NombreConcurso
                                        </option>
                                    }

                                </select>

                            </div>

                            @if (Model.ModoEdicion)
                            {
                                <button type="submit"
                                        asp-page-handler="Actualizar"
                                        class="btn btn-warning">
                                    Actualizar
                                </button>

                                <a href="/Oferentes"
                                   class="btn btn-secondary">
                                    Cancelar
                                </a>
                            }
                            else
                            {
                                <button type="submit"
                                        asp-page-handler="Guardar"
                                        class="btn btn-primary">
                                    Guardar
                                </button>
                            }

                        </form>

                    </div>
                </div>

                <h4>
                    Lista de Oferentes
                </h4>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped tabla-oferentes">

                        <thead>

                            <tr>
                                <th>Identificación</th>
                                <th>Tipo</th>
                                <th>Nombre</th>
                                <th>Fecha nacimiento</th>
                                <th>Correo</th>
                                <th>Teléfono</th>
                                <th>Concurso</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.ListaOferentes)
                            {
                                <tr>

                                    <td>@item.Identificacion</td>

                                    <td>@item.TipoIdentificacion</td>

                                    <td>@item.NombreCompleto</td>

                                    <td>@item.FechaNacimiento.ToString("yyyy-MM-dd")</td>

                                    <td>@item.Correo</td>

                                    <td>@item.Telefono</td>

                                    <td>@item.NombreConcurso</td>

                                    <td>
                                        <div class="acciones-oferente">

                                            <a asp-page="/Oferentes"
                                               asp-route-identificacion="@item.Identificacion"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <a asp-page="/PreparacionAcademica"
                                               asp-route-identificacionOferente="@item.Identificacion"
                                               class="btn btn-sm btn-secondary">
                                                Preparación académica
                                            </a>

                                            <a asp-page="/ExperienciaLaboral"
                                               asp-route-identificacionOferente="@item.Identificacion"
                                               class="btn btn-sm btn-secondary">
                                                Experiencia laboral
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?');">

                                                <input type="hidden"
                                                       name="identificacion"
                                                       value="@item.Identificacion" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
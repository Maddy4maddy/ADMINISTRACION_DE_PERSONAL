@page
@model AdministraciondePersonal.Pages.UsuariosModel
@{
    Layout = null;
    ViewData["Title"] = "Administración de Usuarios";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Administración de Usuarios</title>
    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            .usuarios-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.08)
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px
                }

            .btn-nuevo {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: .3s;
                text-decoration: none
            }

                .btn-nuevo:hover {
                    background-color: #80B0AA
                }

            .tabla-usuarios {
                width: 100%;
                border-collapse: collapse;
                border-radius: 20px;
                font-size: 14px
            }

                .tabla-usuarios thead {
                    background-color: #80B0AA;
                    color: white
                }

                .tabla-usuarios th, .tabla-usuarios td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eee;
                    vertical-align: middle
                }

                .tabla-usuarios tbody tr:hover {
                    background-color: #F9EAC1
                }

            .estado-activo, .estado-inactivo, .estado-bloqueado {
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 12px;
                display: inline-block
            }

            .estado-activo {
                background-color: #2ECC71
            }

            .estado-inactivo {
                background-color: #E74C3C
            }

            .estado-bloqueado {
                background-color: #F39C12
            }

            .btn-accion {
                background: 0 0;
                border: none;
                font-size: 18px;
                cursor: pointer;
                margin: 0 5px;
                padding: 5px 10px;
                border-radius: 10px;
                transition: .3s
            }

            .btn-editar {
                color: #273a77
            }

                .btn-editar:hover {
                    background-color: #80B0AA;
                    color: white
                }

            .btn-eliminar {
                color: #d9534f
            }

                .btn-eliminar:hover {
                    background-color: #d9534f;
                    color: white
                }

            .btn-activar {
                color: #2ECC71
            }

                .btn-activar:hover {
                    background-color: #2ECC71;
                    color: white
                }

            .btn-desactivar {
                color: #E74C3C
            }

                .btn-desactivar:hover {
                    background-color: #E74C3C;
                    color: white
                }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center
            }

            .modal-content {
                background: white;
                border-radius: 30px;
                padding: 30px;
                width: 90%;
                max-width: 650px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.2);
                max-height: 90vh;
                overflow-y: auto
            }

                .modal-content h3 {
                    color: #273a77;
                    margin-bottom: 20px;
                    font-size: 24px
                }

                .modal-content label {
                    display: block;
                    margin-bottom: 5px;
                    color: #273a77;
                    font-weight: bold
                }

                .modal-content input, .modal-content select {
                    width: 100%;
                    padding: 10px;
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    font-size: 14px;
                    margin-bottom: 15px;
                    outline: 0
                }

                    .modal-content input:focus, .modal-content select:focus {
                        border-color: #FDB3CA
                    }

            .roles-group {
                border: 2px solid #C8EDED;
                border-radius: 10px;
                padding: 15px;
                margin-bottom: 15px;
                max-height: 200px;
                overflow-y: auto
            }

                .roles-group h4 {
                    color: #273a77;
                    font-size: 14px;
                    margin-bottom: 10px
                }

            .checkbox-item {
                display: flex;
                align-items: center;
                margin-bottom: 8px;
                cursor: pointer
            }

                .checkbox-item input[type="checkbox"] {
                    width: auto;
                    margin-right: 10px;
                    margin-bottom: 0;
                    cursor: pointer
                }

                .checkbox-item label {
                    margin-bottom: 0;
                    cursor: pointer;
                    font-weight: 400;
                    color: #333
                }

                .checkbox-item:hover {
                    background-color: #F9EAC1;
                    padding-left: 5px;
                    border-radius: 5px
                }

            .modal-buttons {
                display: flex;
                gap: 15px;
                justify-content: flex-end;
                margin-top: 20px
            }

                .modal-buttons button {
                    padding: 10px 20px;
                    border-radius: 15px;
                    border: none;
                    cursor: pointer;
                    font-weight: bold
                }

            .btn-guardar {
                background-color: #273a77;
                color: white
            }

            .btn-cancelar {
                background-color: #ccc;
                color: #333;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                padding: 10px 20px;
                border-radius: 15px
            }

            .badge-role {
                display: inline-block;
                background-color: #80B0AA;
                color: white;
                padding: 3px 8px;
                border-radius: 12px;
                font-size: 11px;
                margin: 2px
            }

            .pagination {
                margin-top: 20px
            }

                .pagination .page-link {
                    color: #273a77
                }

                .pagination .active .page-link {
                    background-color: #273a77;
                    border-color: #273a77;
                    color: white
                }

            .modal-mensaje .modal-content {
                background: white;
                border-radius: 20px;
                border: none;
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
                max-width: 400px
            }

            .modal-mensaje .modal-header {
                border-bottom: 1px solid #e5e5e5;
                padding: 20px 24px 12px;
                background: white
            }

                .modal-mensaje .modal-header .modal-title {
                    font-size: 20px;
                    font-weight: 600;
                    color: red
                }

            .modal-mensaje .modal-body {
                padding: 20px 24px 24px;
                font-size: 15px;
                color: #555;
                text-align: center
            }

            .modal-mensaje .modal-footer {
                border-top: none;
                justify-content: center;
                padding: 0 24px 24px
            }

            .btn-modal {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 10px 32px;
                border-radius: 30px;
                font-size: 14px;
                font-weight: 500;
                cursor: pointer;
                transition: .2s;
                min-width: 100px
            }

                .btn-modal:hover {
                    background-color: #1e2d5c;
                    transform: scale(1.02)
                }

            .btn-modal-danger {
                background-color: #273a77
            }

                .btn-modal-danger:hover {
                    background-color: #1e2d5c
                }

            .small-text {
                font-size: 12px;
                color: #666;
                display: block;
                margin-top: -10px;
                margin-bottom: 10px
            }

            .error-message {
                color: #dc3545;
                font-size: 12px;
                margin-bottom: 10px
            }

            .error-field {
                margin-bottom: 5px
            }

            @@media (max-width:576px) {
                .modal-mensaje .modal-content {
                    max-width: 90%
                }

                .btn-modal {
                    padding: 8px 24px;
                    min-width: 80px
                }
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono"><img src="~/css/images/icono.png" alt="Icono del sistema"></div>
            <h3>AdminPersonal</h3>
        </div>
        <ul class="nav-menu">

            @foreach (var pantalla in Model.MenuPantallas)
            {
                <li class="nav-item">

                    <a href="@pantalla.Ruta" class="nav-link">

                        <span>
                            @pantalla.NombrePantalla
                        </span>

                    </a>

                </li>
            }

        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color:@Model.ColorAvatar">@Model.InicialAvatar</div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Administración de Usuarios</h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div id="successModalData" data-message="@Model.Mensaje" data-type="success" style="display:none"></div>
                }
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div id="errorModalData" data-message="@Model.Error" data-type="error" style="display:none"></div>
                }

                <div class="usuarios-container">
                    <div class="header-acciones">
                        <h2>Listado de Usuarios</h2>
                        <a href="/Usuarios?nuevo=true" class="btn-nuevo">+ Nuevo Usuario</a>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-usuarios">
                            <thead>
                                <tr><th>ID</th><th>Usuario</th><th>Nombre Completo</th><th>Correo</th><th>Roles</th><th>Estado</th><th>Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.Usuarios)
                                {
                                    <tr>
                                        <td>@usuario.IdUsuario</td>
                                        <td>@usuario.NombreUsuario</td>
                                        <td>@usuario.NombreCompleto</td>
                                        <td>@usuario.Correo</td>
                                        <td>
                                            @foreach (var rol in usuario.Roles)
                                            {
                                                <span class="badge-role">@rol.NombreRol</span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.Estado == "activo")
                                            {
                                                <span class="estado-activo">Activo</span>
                                            }
                                            else if (usuario.Estado == "inactivo")
                                            {
                                                <span class="estado-inactivo">Inactivo</span>
                                            }
                                            else
                                            {
                                                <span class="estado-bloqueado">Bloqueado</span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="Editar" asp-route-id="@usuario.IdUsuario" asp-route-paginaActual="@Model.PaginaActual" style="display:inline">
                                                <button type="submit" class="btn-accion btn-editar" title="Editar">
                                                    Editar
                                                </button>
                                            </form>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  asp-route-id="@usuario.IdUsuario"
                                                  asp-route-paginaActual="@Model.PaginaActual"
                                                  style="display:inline"
                                                  onsubmit="return confirmarEliminacion(@usuario.IdUsuario, '@usuario.NombreUsuario');">
                                                <button type="submit" class="btn-accion btn-eliminar" title="Eliminar">
                                                    Eliminar
                                                </button>
                                            </form>

                                            @if (usuario.Estado == "activo")
                                            {
                                                <form method="post"
                                                      asp-page-handler="CambiarEstado"
                                                      asp-route-id="@usuario.IdUsuario"
                                                      asp-route-nuevoEstado="inactivo"
                                                      asp-route-paginaActual="@Model.PaginaActual"
                                                      style="display:inline"
                                                      onsubmit="return confirmarCambioEstado(@usuario.IdUsuario, '@usuario.NombreUsuario', 'inactivo');">
                                                    <button type="submit" class="btn-accion btn-desactivar" title="Desactivar">
                                                        Desactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="CambiarEstado"
                                                      asp-route-id="@usuario.IdUsuario"
                                                      asp-route-nuevoEstado="activo"
                                                      asp-route-paginaActual="@Model.PaginaActual"
                                                      style="display:inline"
                                                      onsubmit="return confirmarCambioEstado(@usuario.IdUsuario, '@usuario.NombreUsuario', 'activo');">
                                                    <button type="submit" class="btn-accion btn-activar" title="Activar">
                                                        Activar
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="/Usuarios" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                    <a class="page-link" asp-page="/Usuarios" asp-route-pagina="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-page="/Usuarios" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para crear/editar usuario -->
    <div id="modalUsuario" class="modal" style="display: @(Model.MostrarModal ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.UsuarioEditando?.IdUsuario > 0 ? "Editar Usuario" : "Nuevo Usuario")</h3>
            <form method="post" asp-page-handler="Guardar" id="formUsuario" onsubmit="return validarFormulario(event)">
                <input type="hidden" asp-for="UsuarioEditando.IdUsuario" />
                <input type="hidden" name="paginaActual" value="@Model.PaginaActual" />

                <label>Nombre de Usuario *</label>
                <input type="text" asp-for="UsuarioEditando.NombreUsuario" required id="nombreUsuario" />
                <div class="error-message" id="errorNombreUsuario"></div>

                <label>Nombre Completo *</label>
                <input type="text" asp-for="UsuarioEditando.NombreCompleto" required id="nombreCompleto" />

                <label>Correo Electrónico *</label>
                <input type="email" asp-for="UsuarioEditando.Correo" required id="correo" />
                <div class="error-message" id="errorCorreo"></div>

                <label>Contraseña @(Model.UsuarioEditando?.IdUsuario > 0 ? "(dejar en blanco para mantener)" : "*")</label>
                <input type="password" asp-for="NuevaContrasena" id="contrasena" />
                <small class="small-text">Mínimo 8 caracteres: mayúsculas, minúsculas, números y carácter especial</small>
                <div class="error-message" id="errorContrasena"></div>

                <label>Roles * (seleccione al menos uno)</label>
                <div class="roles-group">
                    @for (int i = 0; i < Model.RolesDisponibles.Count; i++)
                    {
                        var rol = Model.RolesDisponibles[i];
                        <div class="checkbox-item">
                            <input type="checkbox" name="RolesSeleccionados" value="@rol.IdRol" id="rol_@rol.IdRol" class="role-checkbox" @(Model.RolesSeleccionados.Contains(rol.IdRol) ? "checked" : "") />
                            <label for="rol_@rol.IdRol">@rol.NombreRol</label>
                        </div>
                    }
                </div>
                <div class="error-message" id="errorRoles"></div>

                <label>Estado</label>
                <select asp-for="UsuarioEditando.Estado">
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                    <option value="bloqueado">Bloqueado</option>
                </select>

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar"> Guardar</button>
                    <a href="/Usuarios?pagina=@Model.PaginaActual" class="btn-cancelar"> Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Éxito -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-mensaje">
                <div class="modal-header">
                    <h5 class="modal-title">Éxito</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="successModalBody">
                    Operación completada exitosamente.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Error -->
    <div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-mensaje">
                <div class="modal-header">
                    <h5 class="modal-title">Error</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="errorModalBody">
                    Ha ocurrido un error.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Función para mostrar modal de éxito
        function mostrarExito(mensaje) {
        document.getElementById('successModalBody').innerHTML = mensaje;
        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
        successModal.show();
        }

        // Función para mostrar modal de error
        function mostrarError(mensaje) {
        document.getElementById('errorModalBody').innerHTML = mensaje;
        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
        errorModal.show();
        }

        // Función para confirmar eliminación
        function confirmarEliminacion(id, nombreUsuario) {
        return confirm(`¿Está seguro de eliminar al usuario ${nombreUsuario}? Esta acción no se puede deshacer.`);
        }

        // Función para confirmar cambio de estado
        function confirmarCambioEstado(id, nombreUsuario, estado) {
        const accion = estado === 'activo' ? 'activar' : 'desactivar';
        return confirm(`¿Está seguro que desea ${accion} al usuario ${nombreUsuario}?`);
        }

        // Validación del formulario
        function validarFormulario(event) {
        let esValido = true;

        // Validar nombre de usuario (mínimo 3 caracteres)
        const nombreUsuario = document.getElementById('nombreUsuario');
        const errorNombreUsuario = document.getElementById('errorNombreUsuario');
        if (nombreUsuario.value.trim().length < 3) {
        errorNombreUsuario.innerHTML = 'El nombre de usuario debe tener al menos 3 caracteres.';
        esValido = false;
        } else {
        errorNombreUsuario.innerHTML = '';
        }

        // Validar correo electrónico
        const correo = document.getElementById('correo');
        const errorCorreo = document.getElementById('errorCorreo');
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!emailRegex.test(correo.value)) {
        errorCorreo.innerHTML = 'Ingrese un correo electrónico válido.';
        esValido = false;
        } else {
        errorCorreo.innerHTML = '';
        }

        // Validar contraseña (solo si se ingresó una nueva o es nuevo usuario)
        const contrasena = document.getElementById('contrasena');
        const errorContrasena = document.getElementById('errorContrasena');
        const esEdicion = @((Model.UsuarioEditando?.IdUsuario > 0).ToString().ToLower());

        if (contrasena.value.length > 0 || !esEdicion) {
        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]).{8,}$/;
        if (!passwordRegex.test(contrasena.value)) {
        errorContrasena.innerHTML = 'La contraseña debe tener mínimo 8 caracteres: mayúsculas, minúsculas, números y carácter especial';
        esValido = false;
        } else {
        errorContrasena.innerHTML = '';
        }
        }

        // Validar que se haya seleccionado al menos un rol
        const rolesSeleccionados = document.querySelectorAll('.role-checkbox:checked');
        const errorRoles = document.getElementById('errorRoles');
        if (rolesSeleccionados.length === 0) {
        errorRoles.innerHTML = 'Debe seleccionar al menos un rol para el usuario.';
        esValido = false;
        } else {
        errorRoles.innerHTML = '';
        }

        if (!esValido) {
        event.preventDefault();
        mostrarError('Por favor, corrija los errores en el formulario.');
        }

        return esValido;
        }

        document.addEventListener('DOMContentLoaded', function() {
        const successData = document.getElementById('successModalData');
        if (successData) {
        const mensaje = successData.getAttribute('data-message');
        if (mensaje && mensaje.trim() !== '') {
        mostrarExito(mensaje);
        }
        }

        const errorData = document.getElementById('errorModalData');
        if (errorData) {
        const mensaje = errorData.getAttribute('data-message');
        if (mensaje && mensaje.trim() !== '') {
        mostrarError(mensaje);
        }
        }
        });
    </script>
</body>
</html>
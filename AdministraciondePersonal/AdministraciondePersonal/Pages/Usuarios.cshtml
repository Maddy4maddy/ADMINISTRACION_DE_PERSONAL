@page
@model AdministraciondePersonal.Pages.UsuariosModel
@{
    Layout = null;
    ViewData["Title"] = "Administración de Usuarios";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Administración de Usuarios</title>

    <meta http-equiv="refresh" content="300; url=/Login?expirada=true">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        .usuarios-container {
            background: white;
            border-radius: 30px;
            padding: 30px;
            box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
        }

        .header-acciones {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .header-acciones h2 {
            color: #80B0AA;
            font-size: 28px;
        }

        .btn-nuevo {
            background-color: #273a77;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 15px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-nuevo:hover {
            background-color: #80B0AA;
        }

        .tabla-usuarios {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
            border-radius: 20px;
        }

        .tabla-usuarios thead {
            background-color: #80B0AA;
            color: white;
        }

        .tabla-usuarios th,
        .tabla-usuarios td {
            padding: 15px;
            text-align: center;
            border-bottom: 1px solid #eeeeee;
        }

        .tabla-usuarios tbody tr:hover {
            background-color: #F9EAC1;
        }

        .estado-activo {
            background-color: #2ECC71;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .estado-inactivo {
            background-color: #E74C3C;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .estado-bloqueado {
            background-color: #F39C12;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .btn-accion {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            margin: 0 5px;
            padding: 5px 10px;
            border-radius: 10px;
            transition: 0.3s;
        }

        .btn-editar {
            color: #273a77;
        }

        .btn-editar:hover {
            background-color: #80B0AA;
            color: white;
        }

        .btn-eliminar {
            color: #d9534f;
        }

        .btn-eliminar:hover {
            background-color: #d9534f;
            color: white;
        }

        .btn-activar {
            color: #2ECC71;
        }

        .btn-activar:hover {
            background-color: #2ECC71;
            color: white;
        }

        .btn-desactivar {
            color: #E74C3C;
        }

        .btn-desactivar:hover {
            background-color: #E74C3C;
            color: white;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: white;
            border-radius: 30px;
            padding: 30px;
            width: 90%;
            max-width: 600px;
            box-shadow: 0px 8px 25px rgba(0,0,0,0.2);
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-content h3 {
            color: #273a77;
            margin-bottom: 20px;
            font-size: 24px;
        }

        .modal-content label {
            display: block;
            margin-bottom: 5px;
            color: #273a77;
            font-weight: bold;
        }

        .modal-content input,
        .modal-content select {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 2px solid #C8EDED;
            font-size: 14px;
            margin-bottom: 15px;
            outline: none;
        }

        .modal-content input:focus,
        .modal-content select:focus {
            border-color: #FDB3CA;
        }

        .modal-buttons {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .modal-buttons button {
            padding: 10px 20px;
            border-radius: 15px;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-guardar {
            background-color: #273a77;
            color: white;
        }

        .btn-cancelar {
            background-color: #ccc;
            color: #333;
        }

        .mensaje-flotante {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #273a77;
            color: white;
            padding: 15px 25px;
            border-radius: 15px;
            z-index: 2001;
            animation: fadeOut 3s ease-in-out;
        }

        @@keyframes fadeOut {
            0% { opacity: 1; }
            70% { opacity: 1; }
            100% { opacity: 0; display: none; }
        }

        .small-text {
            font-size: 12px;
            color: #666;
            display: block;
            margin-top: -10px;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="/Bienvenida" class="nav-link">Dashboard</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Roles</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Módulos</a>
            </li>
            <li class="nav-item">
                <a href="/Usuarios" class="nav-link">Administración Usuarios</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Registro Oferentes</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Registro Concursos</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Registro Preparación Académica</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Experiencia Laboral</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Agendar Entrevista</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Contratar Empleado</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Puestos</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Requisitos de Puestos</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Áreas</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Acciones de Personal</a>
            </li>
            <li class="nav-item">
                <a href="/Bitacora" class="nav-link">Visualizar Bitácoras</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Parámetros</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Compañías</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Cargar Datos de Ubicación</a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">Administración Instituciones Educativas</a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">@Model.InicialAvatar</div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Administración de Usuarios</h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">@Model.Mensaje</div>
                }
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <div class="usuarios-container">
                    <div class="header-acciones">
                        <h2>Listado de Usuarios</h2>
                        <a href="/Usuarios?nuevo=true" class="btn-nuevo">+ Nuevo Usuario</a>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-usuarios">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Usuario</th>
                                    <th>Nombre Completo</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.Usuarios)
                                {
                                    <tr>
                                        <td>@usuario.IdUsuario</td>
                                        <td>@usuario.NombreUsuario</td>
                                        <td>@usuario.NombreCompleto</td>
                                        <td>@usuario.Correo</td>
                                        <td>@usuario.NombreRol</td>

                                        <td>
                                            @if (usuario.Estado == "activo")
                                            {
                                                <span class="estado-activo">Activo</span>
                                            }
                                            else if (usuario.Estado == "inactivo")
                                            {
                                                <span class="estado-inactivo">Inactivo</span>
                                            }
                                            else
                                            {
                                                <span class="estado-bloqueado">Bloqueado</span>
                                            }
                                        </td>

                                        <td>
                                            <form method="post"
                                                  asp-page-handler="Editar"
                                                  asp-route-id="@usuario.IdUsuario"
                                                  style="display:inline">
                                                <button type="submit"
                                                        class="btn-accion btn-editar"
                                                        title="Editar">
                                                    Editar
                                                </button>
                                            </form>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  asp-route-id="@usuario.IdUsuario"
                                                  style="display:inline"
                                                  onsubmit="return confirm('¿Realmente desea eliminar este usuario?')">
                                                <button type="submit"
                                                        class="btn-accion btn-eliminar"
                                                        title="Eliminar">
                                                    Eliminar
                                                </button>
                                            </form>

                                            @if (usuario.Estado == "activo")
                                            {
                                                <form method="post"
                                                      asp-page-handler="CambiarEstado"
                                                      asp-route-id="@usuario.IdUsuario"
                                                      asp-route-nuevoEstado="inactivo"
                                                      style="display:inline">
                                                    <button type="submit"
                                                            class="btn-accion btn-desactivar"
                                                            title="Desactivar">
                                                        Desactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="CambiarEstado"
                                                      asp-route-id="@usuario.IdUsuario"
                                                      asp-route-nuevoEstado="activo"
                                                      style="display:inline">
                                                    <button type="submit"
                                                            class="btn-accion btn-activar"
                                                            title="Activar">
                                                        Activar
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para crear/editar usuario -->
    <div id="modalUsuario" class="modal" style="display: @(Model.MostrarModal ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.UsuarioEditando?.IdUsuario > 0 ? "Editar Usuario" : "Nuevo Usuario")</h3>

            <form method="post" asp-page-handler="Guardar">
                <input type="hidden" asp-for="UsuarioEditando.IdUsuario" />

                <label>Nombre de Usuario</label>
                <input type="text" asp-for="UsuarioEditando.NombreUsuario" required />

                <label>Nombre Completo</label>
                <input type="text" asp-for="UsuarioEditando.NombreCompleto" required />

                <label>Correo Electrónico</label>
                <input type="email" asp-for="UsuarioEditando.Correo" required />

                <label>Contraseña</label>
                <input type="password" asp-for="NuevaContrasena" />
                <small class="small-text">Mínimo 8 caracteres: mayúsculas, minúsculas, números y carácter especial. Dejar en blanco para mantener la actual (en edición).</small>

                <label>Rol</label>
                <select asp-for="UsuarioEditando.IdRol" class="form-control" required>
                    <option value="">Seleccione un rol</option>
                    @foreach (var rol in Model.RolesDisponibles)
                    {
                        <option value="@rol.IdRol">@rol.NombreRol</option>
                    }
                </select>

                <label>Estado</label>
                <select asp-for="UsuarioEditando.Estado">
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                    <option value="bloqueado">Bloqueado</option>
                </select>

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Guardar</button>
                    <a href="/Usuarios" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        @if (Model.MostrarModal)
        {
            <text>
            // El modal ya se muestra con el style="display:flex"
            </text>
        }
    </script>
</body>
</html>
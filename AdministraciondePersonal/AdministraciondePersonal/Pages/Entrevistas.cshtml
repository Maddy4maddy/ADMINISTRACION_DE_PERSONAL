@page
@model AdministraciondePersonal.Pages.EntrevistasModel

@{
    Layout = null;
    ViewData["Title"] = "Agendar Entrevistas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Agendar Entrevistas</title>

    <!-- AUTOREFRESH: Recarga la página cada 5 minutos para verificar sesión -->
    <meta http-equiv="refresh" content="300; url=/Login?expirada=true">

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .acciones-entrevista {
                display: flex;
                gap: 6px;
                align-items: center;
                white-space: nowrap;
            }

                .acciones-entrevista form {
                    margin: 0;
                }

            .tabla-entrevistas {
                font-size: 14px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">

            <li class="nav-item">
                <a href="/pages/frmRoles.html" class="nav-link">
                    <span>Administración Roles</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Módulos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Usuarios</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Oferentes" class="nav-link">
                    <span>Registro Oferentes</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Concursos" class="nav-link">
                    <span>Registro Concursos</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/PreparacionAcademica" class="nav-link">
                    <span>Registro Preparación Académica</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/ExperienciaLaboral" class="nav-link">
                    <span>Experiencia Laboral</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Entrevistas" class="nav-link">
                    <span>Agendar Entrevista</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Contratar Empleado</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Requisitos de Puestos</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Áreas</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Acciones de Personal</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Bitacora" class="nav-link">
                    <span>Visualizar Bitácoras</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Parámetros</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Administración Compañías</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span>Cargar Datos de Ubicación</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/InstitucionesEducativas" class="nav-link">
                    <span>Administración Instituciones Educativas</span>
                </a>
            </li>

        </ul>

    </div>

    <div class="main-content">

        <div class="topbar">
            <div class="user-info">
                <span class="user-name" id="nombreUsuario">
                    @Model.NombreUsuario
                </span>

                <div class="user-avatar" id="userAvatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">

            <div class="container-fluid mt-4">

                <h2 class="mb-4">Agendar Entrevistas</h2>

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success">@Model.Mensaje</div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <a asp-page="/EntrevistaFormulario"
                   class="btn btn-primary mb-3">
                    Agendar nueva entrevista
                </a>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped tabla-entrevistas">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Oferente</th>
                                <th>Entrevistador</th>
                                <th>Fecha entrevista</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.ListaEntrevistas)
                            {
                                <tr>
                                    <td>@item.IdEntrevista</td>
                                    <td>@item.IdentificacionOferente - @item.NombreOferente</td>
                                    <td>@item.NombreEntrevistador</td>
                                    <td>@item.FechaEntrevista.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.Estado</td>
                                    <td>
                                        <div class="acciones-entrevista">

                                            <a asp-page="/EntrevistaFormulario"
                                               asp-route-idEntrevista="@item.IdEntrevista"
                                               class="btn btn-sm btn-warning">
                                                Cambiar datos
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?');">

                                                <input type="hidden"
                                                       name="idEntrevista"
                                                       value="@item.IdEntrevista" />

                                                <input type="hidden"
                                                       name="paginaActual"
                                                       value="@Model.PaginaActual" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                            <form method="post"
                                                  asp-page-handler="MarcarRealizada">

                                                <input type="hidden"
                                                       name="idEntrevista"
                                                       value="@item.IdEntrevista" />

                                                <input type="hidden"
                                                       name="paginaActual"
                                                       value="@Model.PaginaActual" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        disabled="@(item.Estado == "Realizada")">
                                                    Marcar realizada
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <nav>
                    <ul class="pagination">

                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Entrevistas"
                               asp-route-pagina="@(Model.PaginaActual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Entrevistas"
                                   asp-route-pagina="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Entrevistas"
                               asp-route-pagina="@(Model.PaginaActual + 1)">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>

            </div>

        </div>

    </div>

</body>
</html>
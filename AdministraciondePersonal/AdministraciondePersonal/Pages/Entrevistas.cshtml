@page
@model AdministraciondePersonal.Pages.EntrevistasModel

@{
    Layout = null;
    ViewData["Title"] = "Agendar Entrevistas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Agendar Entrevistas</title>

    <link rel="stylesheet" href="~/css/plantillaglobal.css">
    <link rel="stylesheet" href="~/css/bienvenida.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
            .entrevistas-container {
                background: white;
                border-radius: 30px;
                padding: 30px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.08);
            }

            .header-acciones {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                flex-wrap: wrap;
                gap: 15px;
            }

                .header-acciones h2 {
                    color: #80B0AA;
                    font-size: 28px;
                }

            .btn-nuevo {
                background-color: #273a77;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 15px;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
            }

                .btn-nuevo:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .tabla-entrevistas {
                width: 100%;
                border-collapse: collapse;
                overflow: hidden;
                border-radius: 20px;
                font-size: 14px;
            }

                .tabla-entrevistas thead {
                    background-color: #80B0AA;
                    color: white;
                }

                .tabla-entrevistas th,
                .tabla-entrevistas td {
                    padding: 15px;
                    text-align: center;
                    border-bottom: 1px solid #eeeeee;
                    vertical-align: middle;
                }

                .tabla-entrevistas tbody tr:hover {
                    background-color: #F9EAC1;
                }

            .acciones-entrevista {
                display: flex;
                gap: 8px;
                align-items: center;
                justify-content: center;
                white-space: nowrap;
            }

                .acciones-entrevista form {
                    margin: 0;
                }

            .btn-accion {
                background: none;
                border: none;
                font-size: 16px;
                cursor: pointer;
                margin: 0 3px;
                padding: 5px 8px;
                border-radius: 10px;
                transition: 0.3s;
                text-decoration: none;
                display: inline-block;
                white-space: nowrap;
            }

            .btn-editar {
                color: #273a77;
            }

                .btn-editar:hover {
                    background-color: #80B0AA;
                    color: white;
                }

            .btn-eliminar {
                color: #d9534f;
            }

                .btn-eliminar:hover {
                    background-color: #d9534f;
                    color: white;
                }

            .btn-estado {
                color: #315855;
            }

                .btn-estado:hover {
                    background-color: #315855;
                    color: white;
                }

            .estado-pendiente {
                background-color: #F39C12;
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 12px;
            }

            .estado-realizada {
                background-color: #2ECC71;
                color: white;
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 12px;
            }

            .pagination .page-link {
                color: #273a77;
            }

            .pagination .active .page-link {
                background-color: #273a77;
                border-color: #273a77;
                color: white;
            }

            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,0.5);
                z-index: 2000;
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: white;
                border-radius: 30px;
                padding: 30px;
                width: 90%;
                max-width: 750px;
                box-shadow: 0px 8px 25px rgba(0,0,0,0.2);
                max-height: 90vh;
                overflow-y: auto;
            }

                .modal-content h3 {
                    color: #273a77;
                    margin-bottom: 20px;
                    font-size: 24px;
                }

                .modal-content label {
                    display: block;
                    margin-bottom: 5px;
                    color: #273a77;
                    font-weight: bold;
                }

                .modal-content input,
                .modal-content select {
                    width: 100%;
                    padding: 10px;
                    border-radius: 10px;
                    border: 2px solid #C8EDED;
                    font-size: 14px;
                    margin-bottom: 15px;
                    outline: none;
                }

                    .modal-content input:focus,
                    .modal-content select:focus {
                        border-color: #FDB3CA;
                    }

            .modal-buttons {
                display: flex;
                gap: 15px;
                justify-content: flex-end;
                margin-top: 20px;
            }

                .modal-buttons button,
                .modal-buttons a {
                    padding: 10px 20px;
                    border-radius: 15px;
                    border: none;
                    cursor: pointer;
                    font-weight: bold;
                    text-decoration: none;
                }

            .btn-guardar {
                background-color: #273a77;
                color: white;
            }

            .btn-cancelar {
                background-color: #ccc;
                color: #333;
            }

            .mensaje-exito h3 {
                color: #2ECC71;
            }

            .mensaje-error h3 {
                color: #E74C3C;
            }

            .mensaje-confirmacion h3 {
                color: #273a77;
            }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sistema-icono">
                <img src="~/css/images/icono.png" alt="Icono del sistema">
            </div>
            <h3>AdminPersonal</h3>
        </div>

        <ul class="nav-menu">
            <li class="nav-item"><a href="/Bienvenida" class="nav-link">Dashboard</a></li>
            <li class="nav-item"><a href="/Roles" class="nav-link">Administración Roles</a></li>
            <li class="nav-item"><a href="/Usuarios" class="nav-link">Administración Usuarios</a></li>
            <li class="nav-item"><a href="/Oferentes" class="nav-link">Registro Oferentes</a></li>
            <li class="nav-item"><a href="/Concursos" class="nav-link">Registro Concursos</a></li>
            <li class="nav-item"><a href="/PreparacionAcademica" class="nav-link">Registro Preparación Académica</a></li>
            <li class="nav-item"><a href="/ExperienciaLaboral" class="nav-link">Experiencia Laboral</a></li>
            <li class="nav-item"><a href="/Entrevistas" class="nav-link">Agendar Entrevista</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Contratar Empleado</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Requisitos de Puestos</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Áreas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Acciones de Personal</a></li>
            <li class="nav-item"><a href="/Bitacora" class="nav-link">Visualizar Bitácoras</a></li>
            <li class="nav-item"><a href="/Parametros" class="nav-link">Administración Parámetros</a></li>
            <li class="nav-item"><a href="/Compañia" class="nav-link">Administración Compañías</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Cargar Datos de Ubicación</a></li>
            <li class="nav-item"><a href="/Pantalla" class="nav-link">Administracion de Pantallas</a></li>
            <li class="nav-item"><a href="/InstitucionesEducativas" class="nav-link">Administración Instituciones Educativas</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Administración Módulos</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="user-info">
                <span class="user-name">@Model.NombreUsuario</span>
                <div class="user-avatar" style="background-color: @Model.ColorAvatar">
                    @Model.InicialAvatar
                </div>
            </div>
        </div>

        <div class="page-container">
            <div class="container-fluid mt-4">
                <h2 class="mb-4">Agendar Entrevistas</h2>

                <div class="entrevistas-container">
                    <div class="header-acciones">
                        <h2>Listado de Entrevistas</h2>
                        <a href="/Entrevistas?nuevo=true" class="btn-nuevo">+ Nueva Entrevista</a>
                    </div>

                    <div class="table-responsive">
                        <table class="tabla-entrevistas">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Oferente</th>
                                    <th>Entrevistador</th>
                                    <th>Fecha entrevista</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ListaEntrevistas)
                                {
                                    <tr>
                                        <td>@item.IdEntrevista</td>
                                        <td>@item.IdentificacionOferente - @item.NombreOferente</td>
                                        <td>@item.NombreEntrevistador</td>
                                        <td>@item.FechaEntrevista.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            @if (item.Estado == "Realizada")
                                            {
                                                <span class="estado-realizada">Realizada</span>
                                            }
                                            else
                                            {
                                                <span class="estado-pendiente">Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="acciones-entrevista">
                                                <a href="/Entrevistas?idEntrevista=@item.IdEntrevista"
                                                   class="btn-accion btn-editar">
                                                    Cambiar datos
                                                </a>

                                                <button type="button"
                                                        class="btn-accion btn-eliminar"
                                                        onclick="abrirModalEliminar('@item.IdEntrevista')">
                                                    Eliminar
                                                </button>

                                                <form method="post" asp-page-handler="MarcarRealizada">
                                                    <input type="hidden" name="idEntrevista" value="@item.IdEntrevista" />
                                                    <input type="hidden" name="paginaActual" value="@Model.PaginaActual" />

                                                    <button type="submit"
                                                            class="btn-accion btn-estado"
                                                            disabled="@(item.Estado == "Realizada")">
                                                        Marcar realizada
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav class="mt-4">
                        <ul class="pagination">
                            <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Entrevistas"
                                   asp-route-pagina="@(Model.PaginaActual - 1)">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="/Entrevistas"
                                       asp-route-pagina="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Entrevistas"
                                   asp-route-pagina="@(Model.PaginaActual + 1)">
                                    Siguiente
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>

    <div id="modalEntrevista" class="modal" style="display: @(Model.MostrarFormulario ? "flex" : "none")">
        <div class="modal-content">
            <h3>@(Model.ModoEdicion ? "Cambiar datos de entrevista" : "Agendar nueva entrevista")</h3>

            <form method="post">
                <input type="hidden" asp-for="Entrevista.IdEntrevista" />
                <input type="hidden" asp-for="Entrevista.Estado" />
                <input type="hidden" name="paginaActual" value="@Model.PaginaActual" />

                <label>Oferente</label>
                @if (Model.ModoEdicion)
                {
                    <input type="text"
                           value="@Model.Entrevista.IdentificacionOferente - @Model.Entrevista.NombreOferente"
                           readonly />

                    <input type="hidden" asp-for="Entrevista.IdentificacionOferente" />
                }
                else
                {
                    <select asp-for="Entrevista.IdentificacionOferente" required>
                        <option value="">Seleccione un oferente</option>

                        @foreach (var oferente in Model.Oferentes)
                        {
                            <option value="@oferente.Identificacion">
                                @oferente.Identificacion - @oferente.NombreCompleto
                            </option>
                        }
                    </select>
                }

                <label>Empleado que realizará la entrevista</label>
                <select asp-for="Entrevista.IdUsuarioEntrevistador" required>
                    <option value="0">Seleccione un empleado</option>

                    @foreach (var empleado in Model.Entrevistadores)
                    {
                        <option value="@empleado.IdUsuario">
                            @empleado.NombreCompleto
                        </option>
                    }
                </select>

                <label>Fecha de la entrevista</label>
                <input asp-for="Entrevista.FechaEntrevista"
                       type="datetime-local"
                       required />

                <div class="modal-buttons">
                    @if (Model.ModoEdicion)
                    {
                        <button type="submit" asp-page-handler="Actualizar" class="btn-guardar">
                            Actualizar
                        </button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Guardar" class="btn-guardar">
                            Guardar
                        </button>
                    }

                    <a href="/Entrevistas?pagina=@Model.PaginaActual" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <div id="modalMensaje" class="modal" style="display: @(Model.MostrarMensajeModal ? "flex" : "none")">
        <div class="modal-content @(string.IsNullOrEmpty(Model.Error) ? "mensaje-exito" : "mensaje-error")">
            <h3>@(string.IsNullOrEmpty(Model.Error) ? "Operación exitosa" : "Error")</h3>
            <p>@(string.IsNullOrEmpty(Model.Error) ? Model.Mensaje : Model.Error)</p>

            <div class="modal-buttons">
                <a href="/Entrevistas?pagina=@Model.PaginaActual" class="btn-guardar">Aceptar</a>
            </div>
        </div>
    </div>

    <div id="modalEliminar" class="modal">
        <div class="modal-content mensaje-confirmacion">
            <h3>Confirmar eliminación</h3>
            <p>¿Realmente desea eliminar el elemento seleccionado?</p>

            <form method="post" asp-page-handler="Eliminar">
                <input type="hidden" id="idEntrevistaEliminar" name="idEntrevista" />
                <input type="hidden" name="paginaActual" value="@Model.PaginaActual" />

                <div class="modal-buttons">
                    <button type="submit" class="btn-guardar">Sí</button>
                    <button type="button" class="btn-cancelar" onclick="cerrarModalEliminar()">No</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function abrirModalEliminar(idEntrevista) {
                document.getElementById("idEntrevistaEliminar").value = idEntrevista;
                document.getElementById("modalEliminar").style.display = "flex";
            }

            function cerrarModalEliminar() {
                document.getElementById("modalEliminar").style.display = "none";
            }
    </script>

</body>
</html>